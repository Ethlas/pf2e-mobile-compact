<div class="compendium-picker">
  {{#if staged}}
  <!-- ======================================================== -->
  <!-- SPELL CONFIGURATION & IMPORT MODAL OVERLAY               -->
  <!-- ======================================================== -->
  <div class="spell-config-overlay">
    <div class="spell-config-card">
      <div class="staged-item-header">
        <img class="staged-img" src="{{staged.img}}" alt="{{staged.name}}" width="48" height="48" />
        <div class="staged-title-group">
          <h3 class="staged-name">{{staged.name}}</h3>
          <span class="staged-meta">
            {{#if staged.isCantrip}}
              <span class="staged-badge badge-cantrip">Cantrip</span>
            {{else}}
              <span class="staged-badge badge-rank">Base Rank {{staged.baseRank}}</span>
            {{/if}}
            <span class="staged-traditions"><i class="fas fa-hat-wizard"></i> {{staged.traditionsLabel}}</span>
          </span>
        </div>
      </div>

      {{#if hasEntries}}
      <div class="spell-config-form">
        <!-- Target Spellcasting Entry -->
        <div class="form-group">
          <label for="targetEntry"><i class="fas fa-book-bookmark"></i> Add to Spellcasting Entry</label>
          <select
            id="targetEntry"
            name="targetEntry"
            class="touch-target config-select"
            data-change-action="updateStagedEntry"
            onclick="event.stopPropagation()"
          >
            {{#each spellcastingEntries}}
            <option value="{{this.id}}" {{#if (eq this.id ../staged.selectedEntryId)}}selected{{/if}}>
              {{this.name}} ({{this.tradition}}{{#if this.isSpontaneous}}, Spontaneous{{else if this.isPrepared}}, Prepared{{/if}})
            </option>
            {{/each}}
          </select>
        </div>

        {{#unless staged.entryMatchesTradition}}
        <div class="tradition-warning-banner">
          <i class="fas fa-triangle-exclamation"></i>
          <span>This spell is not native to the selected entry's tradition ({{staged.traditionsLabel}}).</span>
        </div>
        {{/unless}}

        <!-- Target Spell Rank (Minimum is Base Rank) -->
        <div class="form-group">
          <label for="targetRank"><i class="fas fa-layer-group"></i> Add at Rank / Level</label>
          <select
            id="targetRank"
            name="targetRank"
            class="touch-target config-select"
            data-change-action="updateStagedRank"
            onclick="event.stopPropagation()"
          >
            {{#each staged.availableRanks}}
            <option value="{{this.rank}}" {{#if (eq this.rank ../staged.selectedRank)}}selected{{/if}}>
              {{this.label}}
            </option>
            {{/each}}
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="config-actions">
          <button type="button" class="touch-target btn-cancel" data-action="cancelStage">
            <i class="fas fa-xmark"></i> Cancel
          </button>
          <button type="button" class="touch-target btn-confirm-add" data-action="importItem">
            <i class="fas fa-plus"></i> Confirm Add
          </button>
        </div>
      </div>
      {{else}}
      <div class="no-entries-warning">
        <i class="fas fa-circle-exclamation"></i>
        <p>This character has no Spellcasting Entries configured yet.</p>
        <p class="sub-text">Add a Spellcasting Entry on your character sheet first to learn or prepare spells.</p>
        <button type="button" class="touch-target btn-cancel" data-action="cancelStage">
          <i class="fas fa-arrow-left"></i> Back to Spells
        </button>
      </div>
      {{/if}}
    </div>
  </div>
  {{else}}

  <!-- ======================================================== -->
  <!-- SEARCH BAR & FILTER CONTROLS                             -->
  <!-- ======================================================== -->
  <div class="compendium-search-bar">
    <i class="fas fa-magnifying-glass search-icon"></i>
    <input
      type="search"
      class="compendium-search-input touch-target"
      placeholder="Search {{type}}..."
      value="{{query}}"
      onclick="event.stopPropagation()"
      autofocus
    />
  </div>

  {{#if isSpells}}
  <div class="compendium-filters">
    <!-- Rank Filter -->
    <div class="filter-field">
      <label class="filter-label"><i class="fas fa-layer-group"></i> Rank</label>
      <select
        name="rankFilter"
        class="touch-target filter-select"
        data-change-action="updateRankFilter"
        onclick="event.stopPropagation()"
      >
        <option value="all" {{#if (eq rankFilter "all")}}selected{{/if}}>All Ranks</option>
        <option value="cantrip" {{#if (eq rankFilter "cantrip")}}selected{{/if}}>Cantrips</option>
        <option value="1" {{#if (eq rankFilter "1")}}selected{{/if}}>Rank 1</option>
        <option value="2" {{#if (eq rankFilter "2")}}selected{{/if}}>Rank 2</option>
        <option value="3" {{#if (eq rankFilter "3")}}selected{{/if}}>Rank 3</option>
        <option value="4" {{#if (eq rankFilter "4")}}selected{{/if}}>Rank 4</option>
        <option value="5" {{#if (eq rankFilter "5")}}selected{{/if}}>Rank 5</option>
        <option value="6" {{#if (eq rankFilter "6")}}selected{{/if}}>Rank 6</option>
        <option value="7" {{#if (eq rankFilter "7")}}selected{{/if}}>Rank 7</option>
        <option value="8" {{#if (eq rankFilter "8")}}selected{{/if}}>Rank 8</option>
        <option value="9" {{#if (eq rankFilter "9")}}selected{{/if}}>Rank 9</option>
        <option value="10" {{#if (eq rankFilter "10")}}selected{{/if}}>Rank 10</option>
      </select>
    </div>

    <!-- Tradition Filter -->
    <div class="filter-field">
      <label class="filter-label"><i class="fas fa-hat-wizard"></i> Tradition</label>
      <select
        name="traditionFilter"
        class="touch-target filter-select"
        data-change-action="updateTraditionFilter"
        onclick="event.stopPropagation()"
      >
        <option value="all" {{#if (eq traditionFilter "all")}}selected{{/if}}>All Traditions</option>
        {{#if actorTraditions.length}}
        <option value="character" {{#if (eq traditionFilter "character")}}selected{{/if}}>Character Traditions ({{actorTraditionsLabel}})</option>
        {{/if}}
        <option value="arcane" {{#if (eq traditionFilter "arcane")}}selected{{/if}}>Arcane</option>
        <option value="divine" {{#if (eq traditionFilter "divine")}}selected{{/if}}>Divine</option>
        <option value="occult" {{#if (eq traditionFilter "occult")}}selected{{/if}}>Occult</option>
        <option value="primal" {{#if (eq traditionFilter "primal")}}selected{{/if}}>Primal</option>
      </select>
    </div>
  </div>
  {{/if}}

  <!-- ======================================================== -->
  <!-- RESULTS LIST                                             -->
  <!-- ======================================================== -->
  <ul class="compendium-results-list">
    {{#each entries}}
    <li class="compendium-item-row">
      <div class="compendium-item-info">
        {{#if this.img}}
        <img class="compendium-item-img" src="{{this.img}}" alt="{{this.name}}" width="40" height="40" />
        {{/if}}
        <div class="compendium-item-text">
          <span class="compendium-item-name"><strong>{{this.name}}</strong></span>
          {{#if this.system.level.value}}
            <span class="compendium-item-sub">Rank {{this.system.level.value}}</span>
          {{else}}
            <span class="compendium-item-sub">Cantrip</span>
          {{/if}}
        </div>
      </div>
      <button
        type="button"
        class="touch-target btn-import"
        data-action="stageItem"
        data-entry-id="{{this._id}}"
        title="Add to Character"
      >
        <i class="fas fa-plus"></i> Add
      </button>
    </li>
    {{else}}
    <li class="empty-hint">
      <i class="fas fa-circle-info"></i> No spells found matching your search and filter criteria.
    </li>
    {{/each}}
  </ul>
  {{/if}}
</div>
