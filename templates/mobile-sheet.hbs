<div class="mobile-sheet-body">
  <!-- Dynamic Tab Content Area -->
  <main class="mobile-tab-content m-flex-1">
    {{#if isKingdom}}
      {{#if (eq activeTab "turn")}}
        {{> "modules/pf2e-mobile-compact/templates/kingdom/kingdom-turn.hbs"}}
      {{else if (eq activeTab "kingdom")}}
        {{> "modules/pf2e-mobile-compact/templates/kingdom/kingdom-sheet-tab.hbs"}}
      {{else if (eq activeTab "settlements")}}
        {{> "modules/pf2e-mobile-compact/templates/kingdom/kingdom-settlements.hbs"}}
      {{else if (eq activeTab "trade")}}
        {{> "modules/pf2e-mobile-compact/templates/kingdom/kingdom-trade.hbs"}}
      {{else if (eq activeTab "notes")}}
        {{> "modules/pf2e-mobile-compact/templates/kingdom/kingdom-notes.hbs"}}
      {{/if}}
    {{else if isParty}}
      {{#if (eq activeTab "overview")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/party-overview.hbs"}}
      {{else if (eq activeTab "stash")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/party-stash.hbs"}}
      {{/if}}
    {{else}}
      {{#if (eq activeTab "spells")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/spells.hbs"}}
      {{else if (eq activeTab "inventory")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/inventory.hbs"}}
      {{else if (eq activeTab "skills")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/skills.hbs"}}
      {{else if (eq activeTab "actions")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/actions.hbs"}}
      {{else if (eq activeTab "character")}}
        {{> "modules/pf2e-mobile-compact/templates/parts/character.hbs"}}
      {{/if}}
    {{/if}}

    <!-- Persistent Chat Pane (always retains live ui.chat socket stream) -->
    <div class="mobile-tab-pane mobile-chat-pane m-flex-col {{#unless (eq activeTab "chat")}}is-hidden{{/unless}}">
      {{> "modules/pf2e-mobile-compact/templates/parts/chat.hbs"}}
    </div>
  </main>

  <!-- Bottom Navigation Bar: Adaptive for Kingdom vs Party vs Character -->
  <nav class="mobile-bottom-nav m-flex-row {{#if isKingdom}}kingdom-nav{{else if isParty}}party-nav{{/if}}">
    {{#if isKingdom}}
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "turn")}}active{{/if}}"
        data-action="switchTab"
        data-tab="turn"
        aria-label="Turn Tab"
      >
        <i class="fa-solid fa-hourglass-half"></i>
        <span>Turn</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "kingdom")}}active{{/if}}"
        data-action="switchTab"
        data-tab="kingdom"
        aria-label="Kingdom Tab"
      >
        <i class="fa-solid fa-crown"></i>
        <span>Kingdom</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "settlements")}}active{{/if}}"
        data-action="switchTab"
        data-tab="settlements"
        aria-label="Settlements Tab"
      >
        <i class="fa-solid fa-city"></i>
        <span>Settlements</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "trade")}}active{{/if}}"
        data-action="switchTab"
        data-tab="trade"
        aria-label="Trade Tab"
      >
        <i class="fa-solid fa-handshake"></i>
        <span>Trade</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "notes")}}active{{/if}}"
        data-action="switchTab"
        data-tab="notes"
        aria-label="Notes Tab"
      >
        <i class="fa-solid fa-book"></i>
        <span>Notes</span>
      </button>
      <button
        type="button"
        class="nav-item nav-chat m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "chat")}}active{{/if}}"
        data-action="switchTab"
        data-tab="chat"
        aria-label="Chat Tab"
      >
        <div class="nav-icon-wrapper m-inline-flex m-align-center m-justify-center">
          <i class="fas fa-comments"></i>
          <span class="chat-badge m-text-2xs m-bold {{#unless unreadChatCount}}hidden{{/unless}}">{{unreadChatCount}}</span>
        </div>
        <span>Chat</span>
      </button>
    {{else if isParty}}
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "overview")}}active{{/if}}"
        data-action="switchTab"
        data-tab="overview"
        aria-label="Overview Tab"
      >
        <i class="fas fa-users"></i>
        <span>Overview</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "stash")}}active{{/if}}"
        data-action="switchTab"
        data-tab="stash"
        aria-label="Stash Tab"
      >
        <i class="fas fa-box-archive"></i>
        <span>Stash</span>
      </button>
      <button
        type="button"
        class="nav-item nav-chat m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "chat")}}active{{/if}}"
        data-action="switchTab"
        data-tab="chat"
        aria-label="Chat Tab"
      >
        <div class="nav-icon-wrapper m-inline-flex m-align-center m-justify-center">
          <i class="fas fa-comments"></i>
          <span class="chat-badge m-text-2xs m-bold {{#unless unreadChatCount}}hidden{{/unless}}">{{unreadChatCount}}</span>
        </div>
        <span>Chat</span>
      </button>
    {{else}}
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "actions")}}active{{/if}}"
        data-action="switchTab"
        data-tab="actions"
        aria-label="Actions Tab"
      >
        <i class="fas fa-hand-fist"></i>
        <span>Actions</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "spells")}}active{{/if}}"
        data-action="switchTab"
        data-tab="spells"
        aria-label="Spells Tab"
      >
        <i class="fas fa-wand-magic-sparkles"></i>
        <span>Spells</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "inventory")}}active{{/if}}"
        data-action="switchTab"
        data-tab="inventory"
        aria-label="Gear Tab"
      >
        <i class="fas fa-shield-halved"></i>
        <span>Gear</span>
      </button>
      <button
        type="button"
        class="nav-item m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "skills")}}active{{/if}}"
        data-action="switchTab"
        data-tab="skills"
        aria-label="Skills Tab"
      >
        <i class="fas fa-dice-d20"></i>
        <span>Skills</span>
      </button>
      <button
        type="button"
        class="nav-item nav-chat m-flex-col m-align-center m-justify-center m-gap-2 m-flex-1 m-text-md {{#if (eq activeTab "chat")}}active{{/if}}"
        data-action="switchTab"
        data-tab="chat"
        aria-label="Chat Tab"
      >
        <div class="nav-icon-wrapper m-inline-flex m-align-center m-justify-center">
          <i class="fas fa-comments"></i>
          <span class="chat-badge m-text-2xs m-bold {{#unless unreadChatCount}}hidden{{/unless}}">{{unreadChatCount}}</span>
        </div>
        <span>Chat</span>
      </button>
    {{/if}}
  </nav>
</div>
