<div class="physical-dice-dialog-content m-flex-col m-gap-12">
  <!-- Header / Action Title & Target Info -->
  <div class="physical-dialog-header">
    <div class="physical-action-title m-bold">{{title}}</div>
    {{#if subtitle}}
    <div class="physical-action-subtitle m-text-base">{{subtitle}}</div>
    {{/if}}
    {{#if target}}
    <div class="physical-target-badge m-text-base">
      🎯 Target: <strong>{{target.name}}</strong>
    </div>
    {{/if}}
  </div>

  <form class="physical-roll-form" onsubmit="return false;">
    {{#if isCheck}}
    <!-- Check / d20 Roll Entry Section -->
    <div class="physical-d20-section">
      <div class="physical-prompt-msg m-text-xl">
        {{#if checkPrompt}}
          {{checkPrompt}}
        {{else}}
          Roll <strong>1d{{faces}}</strong> physically on the table:
        {{/if}}
      </div>

      <div class="physical-input-wrapper">
        <label for="physical-d20-input" class="visually-hidden">d{{faces}} Result</label>
        <input 
          type="number" 
          id="physical-d20-input"
          name="d20-val" 
          class="physical-die-input touch-target m-bold" 
          inputmode="numeric" 
          pattern="[0-9]*" 
          min="1" 
          max="{{faces}}" 
          placeholder="1 - {{faces}}" 
          required 
          autofocus 
        />
      </div>

      <div class="physical-modifier-info m-text-lg">
        Modifier: <strong>{{#if (gte modifier 0)}}+{{/if}}{{modifier}}</strong> (will be added automatically)
      </div>
      <div class="physical-error-msg hidden m-text-base"></div>
    </div>

    {{else}}
    <!-- Damage Roll Entry Section (Multiple Dice Pools in Rows) -->
    <div class="physical-damage-section">
      <div class="physical-prompt-msg m-text-xl">
        Roll physical dice for each damage type and enter the total below:
      </div>

      <div class="physical-damage-pools m-flex-col m-gap-10">
        {{#each pools}}
        <div class="physical-damage-row" data-pool-id="{{this.id}}">
          <div class="damage-row-header m-flex-row m-align-center m-justify-between">
            <span class="damage-type-badge damage-{{this.type}} m-text-md m-bold">
              {{this.typeLabel}}{{#if this.persistent}} (Persistent){{/if}}
            </span>
            <span class="damage-dice-instruction m-text-xl">
              🎲 Roll <strong>{{this.formula}}</strong>
            </span>
          </div>

          <div class="damage-input-row m-flex-row m-align-center m-gap-10">
            <label for="pool-input-{{this.id}}">Dice Total:</label>
            <input 
              type="number" 
              id="pool-input-{{this.id}}"
              name="pool-{{this.id}}" 
              class="physical-damage-input touch-target m-flex-1 m-bold" 
              inputmode="numeric" 
              pattern="[0-9]*" 
              data-pool-id="{{this.id}}" 
              data-min="{{this.min}}" 
              data-max="{{this.max}}" 
              min="{{this.min}}" 
              max="{{this.max}}" 
              placeholder="{{this.min}} - {{this.max}}" 
              required 
              {{#if @first}}autofocus{{/if}} 
            />
          </div>

          {{#if this.mod}}
          <div class="damage-mod-note m-text-md">
            Modifier: {{#if (gte this.mod 0)}}+{{/if}}{{this.mod}} {{this.typeLabel}} will be added automatically
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      <div class="physical-error-msg hidden m-text-base"></div>
    </div>
    {{/if}}

    <!-- Dialog Actions -->
    <div class="physical-dialog-footer m-flex-row m-gap-10">
      <button type="button" class="btn-cancel touch-target m-flex-1" data-action="cancel">
        Cancel
      </button>
      <button type="button" class="btn-submit btn-primary touch-target m-bold" data-action="submit">
        Submit Roll
      </button>
    </div>
  </form>
</div>
