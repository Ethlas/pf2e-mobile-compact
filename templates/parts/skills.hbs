<div class="tab-pane skills-tab" data-tab="skills">
  {{#if coreSkills.length}}
  <!-- Core Skills Section -->
  <section class="actions-section core-skills-section">
    <h3 class="section-title"><i class="fas fa-dice-d20"></i> Core Skills</h3>
    <div class="skills-grid m-gap-8">
      {{#each coreSkills as |skill|}}
      <button
        type="button"
        class="touch-target skill-button prof-rank-{{skill.rank}} m-flex-row m-align-center m-justify-between"
        data-action="rollSkill"
        data-skill="{{skill.slug}}"
        data-statistic="{{skill.slug}}"
        aria-label="{{skill.label}} Check ({{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}})"
      >
        <div class="m-flex-row m-align-center m-gap-6 m-flex-auto m-min-w-0">
          <span class="skill-rank-badge rank-{{skill.rank}} m-inline-flex m-align-center m-justify-center m-shrink-0" title="{{skill.rankName}}">{{skill.rankLetter}}</span>
          <span class="skill-name m-truncate">{{skill.label}}</span>
        </div>
        <span class="skill-mod m-shrink-0">{{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}}</span>
      </button>
      {{/each}}
    </div>
  </section>
  {{else}}
  <!-- Unified Skills Section Fallback -->
  <section class="actions-section">
    <h3 class="section-title"><i class="fas fa-dice-d20"></i> Skills</h3>
    <div class="skills-grid m-gap-8">
      {{#each skills as |skill|}}
      <button
        type="button"
        class="touch-target skill-button m-flex-row m-align-center m-justify-between {{#if skill.isLore}}is-lore{{/if}} prof-rank-{{skill.rank}}"
        data-action="rollSkill"
        data-skill="{{skill.slug}}"
        data-statistic="{{skill.slug}}"
        aria-label="{{skill.label}} Check ({{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}})"
      >
        <div class="m-flex-row m-align-center m-gap-6 m-flex-auto m-min-w-0">
          <span class="skill-rank-badge rank-{{skill.rank}} m-inline-flex m-align-center m-justify-center m-shrink-0" title="{{skill.rankName}}">{{skill.rankLetter}}</span>
          <span class="skill-name m-truncate">{{skill.label}}</span>
        </div>
        <span class="skill-mod m-shrink-0">{{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}}</span>
      </button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if loreSkills.length}}
  <!-- Lore Skills Section -->
  <section class="actions-section lore-skills-section">
    <h3 class="section-title"><i class="fas fa-book-atlas"></i> Lore Skills</h3>
    <div class="skills-grid m-gap-8">
      {{#each loreSkills as |skill|}}
      <button
        type="button"
        class="touch-target skill-button is-lore prof-rank-{{skill.rank}} m-flex-row m-align-center m-justify-between"
        data-action="rollSkill"
        data-skill="{{skill.slug}}"
        data-statistic="{{skill.slug}}"
        aria-label="{{skill.label}} Check ({{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}})"
      >
        <div class="m-flex-row m-align-center m-gap-6 m-flex-auto m-min-w-0">
          <span class="skill-rank-badge rank-{{skill.rank}} m-inline-flex m-align-center m-justify-center m-shrink-0" title="{{skill.rankName}}">{{skill.rankLetter}}</span>
          <span class="skill-name m-truncate">{{skill.label}}</span>
        </div>
        <span class="skill-mod m-shrink-0">{{#if (gte skill.mod 0)}}+{{/if}}{{skill.mod}}</span>
      </button>
      {{/each}}
    </div>
  </section>
  {{/if}}
</div>
