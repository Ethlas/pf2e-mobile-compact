<div class="spell-picker-dialog mobile-dialog">
  <div class="spell-picker-header">
    <h4><i class="fas fa-book-sparkles"></i> Select Spell for Rank {{rank}}</h4>
    <p class="dialog-subtitle m-text-sm m-color-dim">Choose a spell from your repertoire to prepare in Slot {{slotNumber}}.</p>
    <div class="spell-picker-search m-flex-row m-align-center">
      <i class="fas fa-search search-icon"></i>
      <input type="text" class="spell-picker-input touch-target m-text-base m-color-strong" placeholder="Filter spells by name..." autofocus />
    </div>
  </div>

  <div class="spell-picker-list m-flex-col m-gap-6 m-flex-1">
    {{#each spells as |spell|}}
    <div class="spell-picker-item touch-target m-flex-row m-align-center m-gap-10" data-action="confirmPrepareSpell" data-item-id="{{spell.id}}" data-spell-name="{{spell.name}}">
      <img class="spell-item-img m-shrink-0" src="{{spell.img}}" alt="{{spell.name}}" />
      <div class="m-flex-1 m-min-w-0">
        <div class="m-flex-row m-align-center m-gap-6">
          <span class="m-truncate m-text-base m-color-strong"><strong>{{spell.name}}</strong></span>
          {{#if spell.glyph}}
          <span class="action-cost-glyph m-inline-flex m-align-center m-justify-center m-shrink-0 m-text-base m-color-accent"><span class="action-glyph">{{spell.glyph}}</span></span>
          {{/if}}
        </div>
        <div class="spell-item-meta m-flex-row m-wrap m-gap-4">
          <span class="detail-tag m-badge">Base Rank {{spell.baseRank}}</span>
          {{#if spell.range}}<span class="detail-tag m-badge">Range: {{spell.range}}</span>{{/if}}
          {{#if spell.target}}<span class="detail-tag m-badge">Target: {{spell.target}}</span>{{/if}}
        </div>
      </div>
      <button type="button" class="touch-target btn-select-spell m-inline-flex m-align-center m-gap-4 m-shrink-0 m-text-md m-semibold" data-action="confirmPrepareSpell" data-item-id="{{spell.id}}">
        <i class="fas fa-check"></i> Prepare
      </button>
    </div>
    {{else}}
    <p class="empty-hint">No spells available to prepare at this rank. Add spells using "Add Spell from SRD".</p>
    {{/each}}
  </div>
</div>
