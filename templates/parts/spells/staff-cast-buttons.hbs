{{!--
  Cast buttons for a staff spell (data-action="castStaffSpell").
  Cantrips cost no charges. When the character also has spontaneous slots of the
  spell's rank or higher, two buttons are shown: pay the full charge cost, or pay
  1 charge plus a spell slot. Otherwise only the full-charge-cost button is shown.
  Availability flags come from prepareActivationsContext() in context-activations.js.

  Parameters (hash):
    spell    Formatted staff spell (formatSpell() plus the staff charge fields)
    rank     Rank of the staff rank group the spell is listed under
    staffId  Id of the staff item
--}}
{{#if spell.isCantrip}}
<button type="button" class="touch-target btn-cast" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="0" data-charge-cost="0" title="Cast Cantrip">
  <i class="fas fa-wand-magic"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}}
</button>
{{else if spell.hasSpontaneousOption}}
  {{#if spell.canCastCharges}}
  <button type="button" class="touch-target btn-cast btn-staff-charges" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="{{spell.chargeCost}}" title="Cast using {{spell.chargeCost}} staff charges">
    <i class="fas fa-bolt"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}} · {{spell.chargeCost}} Chg
  </button>
  {{else}}
  <button type="button" class="touch-target btn-cast btn-staff-charges disabled" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="{{spell.chargeCost}}" title="{{#if spell.chargesDisabledReason}}{{spell.chargesDisabledReason}}{{else}}Not enough charges (requires {{spell.chargeCost}}){{/if}}">
    <i class="fas fa-bolt"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}} · {{spell.chargeCost}} Chg
  </button>
  {{/if}}

  {{#if spell.canCastSpontaneous}}
  <button type="button" class="touch-target btn-cast btn-staff-spontaneous" data-action="castStaffSpell" data-cast-mode="spontaneous" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="1" title="Cast using 1 staff charge and 1 Rank {{rank}}+ spontaneous slot">
    <i class="fas fa-wand-magic-sparkles"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}} · 1 Chg + Slot
  </button>
  {{else}}
  <button type="button" class="touch-target btn-cast btn-staff-spontaneous disabled" data-action="castStaffSpell" data-cast-mode="spontaneous" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="1" title="{{#if spell.spontaneousDisabledReason}}{{spell.spontaneousDisabledReason}}{{else}}Not enough charges or slots (requires 1 charge + 1 Rank {{rank}}+ slot){{/if}}">
    <i class="fas fa-wand-magic-sparkles"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}} · 1 Chg + Slot
  </button>
  {{/if}}
{{else}}
<button type="button" class="touch-target btn-cast {{#unless spell.canCastCharges}}disabled{{/unless}}" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="{{spell.chargeCost}}" title="{{#if spell.canCastCharges}}Cast using {{spell.chargeCost}} staff charges{{else if spell.chargesDisabledReason}}{{spell.chargesDisabledReason}}{{else}}Not enough charges (requires {{spell.chargeCost}}){{/if}}">
  <i class="fas fa-bolt"></i> Cast{{#if spell.castActions}} ({{spell.castActions}}){{/if}} · {{spell.chargeCost}} Chg
</button>
{{/if}}
