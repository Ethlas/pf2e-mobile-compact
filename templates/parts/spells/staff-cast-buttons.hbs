{{!--
  Cast buttons for a staff spell (data-action="castStaffSpell").
  Cantrips cost no charges. When the character also has spontaneous slots of the
  spell's rank or higher, two buttons are shown: pay the full charge cost, or pay
  1 charge plus a spell slot. Otherwise only the full-charge-cost button is shown.
  Availability flags come from prepareActivationsContext() in context-activations.js.

  Parameters (hash):
    spell    Formatted staff spell (formatSpell() plus the staff charge fields)
    rank     Rank of the staff rank group the spell is listed under
    staffId  Id of the staff item
--}}
{{#if spell.isCantrip}}
<button type="button" class="touch-target btn-cast m-inline-flex m-align-center m-justify-center m-text-base" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="0" data-charge-cost="0" title="Cast Cantrip">
  <i class="fas fa-wand-magic-sparkles"></i>
</button>
{{else if spell.hasSpontaneousOption}}
  <button type="button" class="touch-target btn-cast btn-staff-charges m-inline-flex m-align-center m-justify-center m-text-base {{#unless spell.canCastCharges}}disabled{{/unless}}" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="{{spell.chargeCost}}" title="{{#if spell.canCastCharges}}Cast using {{spell.chargeCost}} staff charges{{else if spell.chargesDisabledReason}}{{spell.chargesDisabledReason}}{{else}}Not enough charges (requires {{spell.chargeCost}}){{/if}}">
    <i class="fas fa-bolt"></i>&nbsp;  {{spell.chargeCost}} Charge
  </button>

  <button type="button" class="touch-target btn-cast btn-staff-spontaneous m-inline-flex m-align-center m-justify-center m-text-base {{#unless spell.canCastSpontaneous}}disabled{{/unless}}" data-action="castStaffSpell" data-cast-mode="spontaneous" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="1" title="{{#if spell.canCastSpontaneous}}Cast using 1 staff charge and 1 Rank {{rank}}+ spontaneous slot{{else if spell.spontaneousDisabledReason}}{{spell.spontaneousDisabledReason}}{{else}}Not enough charges or slots (requires 1 charge + 1 Rank {{rank}}+ slot){{/if}}">
    <i class="fas fa-wand-magic-sparkles"></i> &nbsp;  1 Charge + Slot
  </button>
{{else}}
  <button type="button" class="touch-target btn-cast m-inline-flex m-align-center m-justify-center m-text-base {{#unless spell.canCastCharges}}disabled{{/unless}}" data-action="castStaffSpell" data-cast-mode="charges" data-staff-id="{{staffId}}" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-charge-cost="{{spell.chargeCost}}" title="{{#if spell.canCastCharges}}Cast using {{spell.chargeCost}} staff charges{{else if spell.chargesDisabledReason}}{{spell.chargesDisabledReason}}{{else}}Not enough charges (requires {{spell.chargeCost}}){{/if}}">
    <i class="fas fa-bolt"></i> &nbsp; {{spell.chargeCost}} Charge
  </button>
{{/if}}
