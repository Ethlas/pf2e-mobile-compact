<div class="tab-pane m-flex-col" data-tab="spells">
  <!-- Sub-Navigation: Spells vs Preparation vs Activations -->
  {{#if (or hasPreparedEntry hasActivations)}}
  <div class="spell-subtabs m-panel m-flex-row m-gap-6">
    <button type="button" class="subtab-btn m-flex-row m-align-center m-justify-center m-gap-6 m-flex-1 m-text-base m-semibold m-color-muted {{#if (eq spellSubTab "spells")}}active{{/if}}" data-action="switchSpellSubTab" data-subtab="spells">
      <i class="fas fa-wand-magic-sparkles"></i> Spells
    </button>
    {{#if hasPreparedEntry}}
    <button type="button" class="subtab-btn m-flex-row m-align-center m-justify-center m-gap-6 m-flex-1 m-text-base m-semibold m-color-muted {{#if (eq spellSubTab "preparation")}}active{{/if}}" data-action="switchSpellSubTab" data-subtab="preparation">
      <i class="fas fa-book-open"></i> Preparation
    </button>
    {{/if}}
    {{#if hasActivations}}
    <button type="button" class="subtab-btn m-flex-row m-align-center m-justify-center m-gap-6 m-flex-1 m-text-base m-semibold m-color-muted {{#if (eq spellSubTab "activations")}}active{{/if}}" data-action="switchSpellSubTab" data-subtab="activations">
      <i class="fas fa-bolt"></i> Activations
      {{#if activationsCount}}
      <span class="subtab-count-badge m-text-xs m-bold m-color-strong">{{activationsCount}}</span>
      {{/if}}
    </button>
    {{/if}}
  </div>
  {{/if}}

  <!-- Action Bar: Add Spell from SRD, Daily Prep Reset, Dailies (focus points are in the Focus Spells header) -->
  <div class="tab-action-bar m-flex-row m-align-center m-justify-between m-gap-8">
    <button type="button" class="btn-primary m-compact m-bold m-color-strong" data-action="openCompendiumPicker" data-type="spells">
      <i class="fas fa-plus"></i> Add Spell
    </button>
    <button type="button" class="btn-daily-reset m-compact m-inline-flex m-align-center m-gap-6 m-text-md m-semibold" data-action="resetDailySpells" title="Restore all expended spell slots and focus points">
      <i class="fas fa-bed"></i> Daily Rest
    </button>
    {{#if hasDailies}}
    <button type="button" class="btn-dailies m-compact m-inline-flex m-align-center m-gap-6 m-text-md m-semibold" data-action="openDailies" title="Open Daily Preparations (pf2e-dailies)">
      <i class="fas fa-sun"></i> Dailies
    </button>
    {{/if}}
  </div>

  {{#if (or (eq spellSubTab "spells") (and (not (eq spellSubTab "preparation")) (not (eq spellSubTab "activations"))))}}
  <!-- ======================================================== -->
  <!-- 1. CAST VIEW: Spells by Entry, then by Rank             -->
  <!-- ======================================================== -->
  <div class="spells-cast-view">
    <!-- pf2e's roll-option toggles for spellcasting (Blood Magic, Spellshape ...) -->
    {{#if toggles.spellcasting.length}}{{> "modules/pf2e-mobile-compact/templates/parts/toggles.hbs" toggles=toggles.spellcasting key="toggles-spellcasting" collapsed=togglesCollapsed.spellcasting title="Special Abilities" icon="fa-star"}}{{/if}}
    {{!-- One section per spellcasting entry (class, focus tradition, feat, staff entry ...), like pf2e's sheet:
          a header with the entry's name, tradition and proficiency, and its own spell DC and attack bonus
          (entries can use another attribute or rank), then the entry's spell groups. A group's collapse key
          is scoped to its entry (collapseKey "<entryId>-<rank>"); data-rank on the -/+ slot buttons stays
          the rank itself. --}}
    {{#each spellEntries as |spellEntry|}}
    <div class="spell-entry m-flex-col" data-entry-id="{{spellEntry.id}}">
    <div class="spell-entry-header m-flex-col m-gap-8">
      {{!-- Move the entry up or down (its sort value, like dragging an entry on pf2e's sheet): two small arrows
            sitting in the header's top border, at the right edge. The first entry's up and the last entry's down are
            disabled and greyed out; with only one entry there are no arrows. --}}
      {{#if (gt @root.spellEntries.length 1)}}
      <div class="spell-entry-move m-flex-row">
        <button type="button" class="btn-entry-move m-flex-row m-text-xs" data-action="moveSpellEntry" data-entry-id="{{spellEntry.id}}" data-direction="up" title="Move up" aria-label="Move {{spellEntry.name}} up" {{#if @first}}disabled{{/if}}><i class="fas fa-chevron-up"></i></button>
        <button type="button" class="btn-entry-move m-flex-row m-text-xs" data-action="moveSpellEntry" data-entry-id="{{spellEntry.id}}" data-direction="down" title="Move down" aria-label="Move {{spellEntry.name}} down" {{#if @last}}disabled{{/if}}><i class="fas fa-chevron-down"></i></button>
      </div>
      {{/if}}
      <div class="m-flex-row m-align-center m-gap-8">
        <h3 class="rank-title m-flex-row m-align-center m-min-w-0 m-text-xl m-bold m-color-accent"><i class="fas fa-book"></i> <span class="m-truncate">{{spellEntry.name}}</span></h3>
      </div>
      {{#if (or spellEntry.dc spellEntry.attack spellEntry.tradition spellEntry.rankLetter)}}
      <div class="m-flex-row m-align-center m-justify-between m-gap-8 m-text-md m-color-soft">
        <div class="m-flex-row m-align-center m-gap-12 m-min-w-0">
          {{#if spellEntry.dc}}<span><strong class="m-text-xl m-color-strong">{{spellEntry.dc}}</strong> Spell DC</span>{{/if}}
          {{#if spellEntry.attack}}<span><strong class="m-text-xl m-color-strong">{{spellEntry.attack}}</strong> Spell Attack</span>{{/if}}
        </div>
        <div class="m-flex-row m-align-center m-gap-6 m-shrink-0">
          {{#if spellEntry.tradition}}<span>{{spellEntry.tradition}}</span>{{/if}}
          {{#if spellEntry.rankLetter}}<span class="skill-rank-badge rank-{{spellEntry.rank}} m-text-xs m-bold m-inline-flex m-align-center m-justify-center m-shrink-0" title="{{spellEntry.rankName}}">{{spellEntry.rankLetter}}</span>{{/if}}
        </div>
      </div>
      {{/if}}
    </div>
    {{#each spellEntry.groups as |group|}}
    <section class="m-group spell-rank-group" data-rank="{{group.collapseKey}}">
      <!-- Collapsible Rank Header -->
      <div class="spell-rank-header m-flex-row m-align-center m-justify-between" data-action="toggleRankGroup" data-rank="{{group.collapseKey}}" title="Toggle {{group.label}}">
        <div class="m-flex-row m-align-center m-gap-8">
          <i class="fas fa-chevron-down rank-expand-icon m-text-md m-color-dim {{#if group.isCollapsed}}collapsed{{/if}}"></i>
          <h3 class="rank-title m-text-xl m-bold m-color-dim">{{group.label}}</h3>
          <span class="rank-count-badge m-text-xs m-bold m-color-normal">{{group.spellCount}}</span>
        </div>

        {{#if group.hasSlots}}
        <div class="slot-counter m-flex-row m-align-center m-gap-6 m-text-md m-color-soft">
          <span title="Spell slots"><strong class="m-text-xl m-color-slot">{{group.slots.value}} / {{group.slots.max}}</strong></span>
          <button type="button" class="btn-slot-adjust m-flex-row m-align-center m-justify-center m-text-xl m-bold" data-action="adjustSlot" data-rank="{{group.rank}}" data-entry-id="{{group.entryId}}" data-delta="-1" title="Decrease Slot">-</button>
          <button type="button" class="btn-slot-adjust m-flex-row m-align-center m-justify-center m-text-xl m-bold" data-action="adjustSlot" data-rank="{{group.rank}}" data-entry-id="{{group.entryId}}" data-delta="1" title="Increase Slot">+</button>
        </div>
        {{/if}}

        {{!-- Focus points in the Focus Spells header, in the place where rank groups show their slots:
              one flame per point. Tapping an available (lit) flame spends a point, tapping a spent
              (dimmed) one regains a point. --}}
        {{#if (and (eq group.rank "focus") @root.focus.max)}}
        <div class="slot-counter focus-counter m-flex-row m-align-center m-gap-6 m-text-md m-color-soft" title="Focus Points: {{@root.focus.value}} / {{@root.focus.max}}">
          {{#each @root.focus.points as |point|}}
          {{#if point.available}}
          <button type="button" class="btn-focus-point m-flex-row m-align-center m-justify-center m-color-accent" data-action="adjustFocus" data-delta="-1" title="Spend a Focus Point" aria-label="Focus Point available, tap to spend">
            <i class="fas fa-fire"></i>
          </button>
          {{else}}
          <button type="button" class="btn-focus-point spent m-flex-row m-align-center m-justify-center m-color-accent" data-action="adjustFocus" data-delta="1" title="Regain a Focus Point" aria-label="Focus Point spent, tap to regain">
            <i class="fas fa-fire"></i>
          </button>
          {{/if}}
          {{/each}}
        </div>
        {{/if}}
      </div>

      <!-- Spells in this Rank -->
      <div class="m-group-list spell-list {{#if group.isCollapsed}}collapsed{{/if}}">
        {{#each group.spells as |listSpell|}}
        {{!-- The rank comes from the spell (castRank): the Focus Spells group has no single rank --}}
        {{#> "modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs" spell=listSpell rank=listSpell.castRank showManageButtons=true}}
          {{!-- Slots can only use the card's parameters (spell, rank) and @root, see spell-card.hbs --}}
          {{#*inline "lineButtons"}}

            {{> "modules/pf2e-mobile-compact/templates/parts/spells/cast-button.hbs" spell=spell rank=rank}}
          {{/inline}}

          {{#*inline "drawerButtons"}}
            {{#if (and spell.isPrepared spell.isExpended)}}
            <button type="button" class="btn-restore-slot m-compact m-inline-flex m-align-center m-justify-center m-gap-4 m-text-md m-semibold" data-action="toggleSlotExpended" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" data-slot-index="{{spell.slotIndex}}" title="Restore Expended Slot">
              <i class="fas fa-arrow-rotate-left"></i>
            </button>
            {{/if}}
          {{/inline}}
        {{/"modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs"}}
        {{else}}
        <p class="empty-hint">No spells available for this rank.</p>
        {{/each}}
      </div>
    </section>
    {{/each}}
    </div>
    {{else}}
    <p class="empty-hint">No spellcasting entries or spells configured on this character.</p>
    {{/each}}
  </div>

  {{else if (eq spellSubTab "preparation")}}
  <!-- ======================================================== -->
  <!-- 2. PREPARATION VIEW: Manage Prepared Slots & Presets    -->
  <!-- ======================================================== -->
  <div class="spells-preparation-view m-flex-col m-gap-12">
    <!-- Presets Toolbar -->
    <div class="spell-presets-bar">
      <div class="presets-header m-flex-row m-align-center m-justify-between">
        <span class="m-flex-row m-align-center m-gap-6 m-text-base m-color-accent"><i class="fas fa-layer-group"></i> <strong>Spell Presets</strong></span>
        <button type="button" class="btn-save-preset m-compact m-inline-flex m-align-center m-gap-4 m-text-md" data-action="saveSpellPreset" title="Save current prepared loadout as preset">
          <i class="fas fa-floppy-disk"></i> Save Current
        </button>
      </div>

      {{#if spellPresets.length}}
      <div class="m-flex-row m-wrap m-gap-6">
        {{#each spellPresets as |preset|}}
        <div class="preset-pill m-inline-flex m-align-center m-gap-6">
          <span class="m-text-md m-semibold m-color-normal">{{preset.name}}</span>
          <button type="button" class="btn-apply-preset m-compact m-inline-flex m-align-center m-gap-4 m-text-sm" data-action="applySpellPreset" data-preset-id="{{preset.id}}" title="Load {{preset.name}}">
            <i class="fas fa-check"></i> Load
          </button>
          <button type="button" class="btn-delete-preset m-compact m-text-md m-color-danger" data-action="deleteSpellPreset" data-preset-id="{{preset.id}}" title="Delete Preset">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="presets-empty-hint m-text-sm m-color-faint">No saved presets yet. Prepare your spells and tap "Save Current" to create one.</p>
      {{/if}}
    </div>

    <!-- Prepared Entries Slot Management -->
    {{#each preparedEntries as |entry|}}
    <div class="prepared-entry-section" data-entry-id="{{entry.id}}">
      <h3 class="entry-section-title m-flex-row m-align-center m-gap-6 m-text-xl m-bold m-color-accent"><i class="fas fa-book"></i> {{entry.name}}</h3>

      {{#each entry.ranks as |rankData|}}
      <div class="prep-rank-card m-panel" data-rank="{{rankData.rank}}">
        <div class="prep-rank-header m-flex-row m-align-center m-justify-between">
          <span class="m-text-base m-color-normal"><strong>{{rankData.label}}</strong></span>
          <span class="m-text-sm m-color-dim">{{rankData.preparedCount}} / {{rankData.maxSlots}} Prepared</span>
        </div>

        <div class="m-flex-col m-gap-6">
          {{#each rankData.slots as |slot|}}
          <div class="slot-row m-flex-row m-align-center m-gap-8 {{#if slot.isEmpty}}slot-empty{{else}}slot-filled{{/if}} {{#if slot.isExpended}}slot-expended{{/if}}">
            <span class="slot-num-badge m-flex-row m-align-center m-justify-center m-shrink-0 m-text-xs m-bold">{{slot.slotNumber}}</span>

            {{#if slot.isEmpty}}
            <div class="m-flex-row m-align-center m-justify-between m-flex-1">
              <span class="slot-placeholder m-text-md m-color-faint">Empty Slot</span>
              <button type="button" class="btn-prepare-slot m-inline-flex m-align-center m-gap-6 m-text-md" data-action="openSpellPrepPicker" data-entry-id="{{entry.id}}" data-rank="{{rankData.rank}}" data-slot-index="{{slot.slotIndex}}">
                <i class="fas fa-plus"></i> Prepare Spell
              </button>
            </div>
            {{else}}
            <div class="m-flex-row m-align-center m-gap-8 m-flex-1 m-min-w-0">
              <img class="slot-spell-img m-shrink-0" src="{{slot.spell.img}}" alt="{{slot.spell.name}}" />
              <div class="m-flex-col m-flex-1 m-min-w-0">
                <span class="m-truncate m-text-base m-color-strong"><strong>{{slot.spell.name}}</strong></span>
                {{#if slot.spell.glyph}}
                <span class="action-cost-glyph m-inline-flex m-align-center m-justify-center m-shrink-0 m-text-base m-color-accent"><span class="action-glyph">{{slot.spell.glyph}}</span></span>
                {{/if}}
                {{#if slot.isExpended}}
                <span class="spell-expended-badge m-badge m-text-xs m-bold">Expended</span>
                {{/if}}
              </div>
              <div class="slot-actions m-flex-row m-gap-4 m-shrink-0">
                <button type="button" class="btn-change-slot m-flex-row m-align-center m-justify-center m-color-info" data-action="openSpellPrepPicker" data-entry-id="{{entry.id}}" data-rank="{{rankData.rank}}" data-slot-index="{{slot.slotIndex}}" title="Change Spell">
                  <i class="fas fa-arrow-right-arrow-left"></i>
                </button>
                <button type="button" class="btn-unprepare-slot m-flex-row m-align-center m-justify-center m-color-danger" data-action="unprepareSlot" data-entry-id="{{entry.id}}" data-rank="{{rankData.rank}}" data-slot-index="{{slot.slotIndex}}" title="Clear Slot">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  {{else if (eq spellSubTab "activations")}}
  {{!-- A wand or scroll without a spell (e.g. a blank "Scroll of 3rd-rank Spell"): its name, Chat and Cast --}}
  {{#*inline "activationItemWithoutSpell"}}
  <div class="m-action-card m-card spell-card" data-item-id="{{item.id}}">
    <div class="m-card-line m-flex-row m-align-center">
      <div class="m-card-main m-flex-col">
        <div class="m-card-title m-flex-row m-align-center"><span class="action-name m-min-w-0 m-truncate"><strong>{{item.name}}</strong></span></div>
        <div class="spell-details m-flex-row m-wrap m-gap-4 m-text-md m-color-muted"><span class="detail-tag m-badge">No spell</span></div>
      </div>
      <div class="action-btn-group m-flex-row m-align-center m-gap-6 m-shrink-0">
        <button type="button" class="btn-action-chat m-compact m-inline-flex m-align-center m-gap-4 m-text-base m-color-normal" data-action="itemToChat" data-item-id="{{item.id}}" title="Send to Chat"><i class="fas fa-message"></i></button>
      </div>
    </div>
  </div>
  {{/inline}}
  <!-- ======================================================== -->
  <!-- 3. ACTIVATIONS VIEW: Staves, Wands, Scrolls & Items      -->
  <!-- ======================================================== -->
  <div class="m-flex-col m-gap-12">
    {{#if activations.staff}}
    <!-- Staff Card & Charges Engine -->
    <div class="staff-activation-group m-flex-col m-gap-8 {{#if activations.staff.isExpanded}}expanded{{/if}}" data-item-id="{{activations.staff.id}}">
      <div class="staff-header-card m-flex-row m-align-center m-gap-10" data-action="toggleActionSummary" data-item-id="{{activations.staff.cardKey}}" title="Toggle Staff Spells">
        <img class="staff-img m-shrink-0" src="{{activations.staff.img}}" alt="{{activations.staff.name}}" />
        <div class="m-flex-col m-gap-4 m-flex-1 m-min-w-0">
          <div class="staff-title-row m-flex-row m-wrap m-align-center m-justify-between m-gap-6">
            <h3 class="staff-name m-truncate m-text-xl m-bold m-color-accent">{{activations.staff.name}}</h3>
            {{#if activations.staff.isEquipped}}
            <span class="equipped-badge badge-held m-badge m-inline-flex m-align-center m-gap-4 m-text-xs m-semibold"><i class="fas fa-hand"></i> Held ({{activations.staff.handsHeld}}H)</span>
            {{else}}
            <span class="equipped-badge badge-not-held m-badge m-inline-flex m-align-center m-gap-4 m-text-xs m-semibold"><i class="fas fa-triangle-exclamation"></i> Not Held</span>
            {{/if}}
            <span class="staff-spells-badge m-badge m-inline-flex m-align-center m-text-xs m-semibold m-color-normal">{{activations.staff.spellCount}} Spells</span>
            <i class="fas fa-chevron-down action-expand-icon m-shrink-0 m-text-sm m-color-dim {{#if activations.staff.isExpanded}}expanded{{/if}}"></i>
          </div>
          <div class="staff-charges-tracker m-flex-row m-align-center m-justify-between m-gap-8">
            <span class="charges-label m-text-base m-color-normal"><i class="fas fa-bolt"></i> Charges: <strong class="m-text-xl m-color-charge">{{activations.staff.charges.value}} / {{activations.staff.charges.max}}</strong></span>
            <div class="charges-buttons m-flex-row m-gap-6">
              <button type="button" class="btn-charge-adjust m-inline-flex m-align-center m-justify-center m-text-xl m-bold m-color-strong" data-action="adjustStaffCharges" data-delta="-1" data-current="{{activations.staff.charges.value}}" data-max="{{activations.staff.charges.max}}" data-staff-id="{{activations.staff.id}}" title="Spend Staff Charge">-1</button>
              <button type="button" class="btn-charge-adjust m-inline-flex m-align-center m-justify-center m-text-xl m-bold m-color-strong" data-action="adjustStaffCharges" data-delta="1" data-current="{{activations.staff.charges.value}}" data-max="{{activations.staff.charges.max}}" data-staff-id="{{activations.staff.id}}" title="Gain Staff Charge">+1</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Expandable Staff Content Drawer (Overview & Spells) -->
      <div class="action-summary staff-drawer-content m-gap-12 m-text-base m-color-normal {{#if activations.staff.isExpanded}}expanded{{else}}collapsed{{/if}}">
        {{#if activations.staff.description}}
        <div class="staff-description-block">
          <div class="staff-description-heading m-flex-row m-align-center m-gap-6 m-text-md m-bold m-color-accent">
            <i class="fas fa-book-open"></i> <span>Staff Overview</span>
          </div>
          <div class="action-description-content">
            {{{activations.staff.description}}}
          </div>
        </div>
        {{/if}}

        <!-- Staff Spells Accordion/List -->
        <div class="staff-spells-list">
          <div class="staff-spells-heading m-flex-row m-align-center m-gap-6 m-text-md m-bold m-color-accent">
            <i class="fas fa-wand-magic-sparkles"></i> <span>Staff Spells ({{activations.staff.spellCount}})</span>
          </div>
          {{#each activations.staff.ranks as |group|}}
          <section class="m-group spell-rank-group staff-rank-group" data-rank="{{group.rank}}">
            <div class="spell-rank-header m-flex-row m-align-center m-justify-between" data-action="toggleRankGroup" data-rank="staff-{{group.rank}}" title="Toggle {{group.label}}">
              <div class="m-flex-row m-align-center m-gap-8">
                <i class="fas fa-chevron-down rank-expand-icon m-text-md m-color-dim {{#if group.isCollapsed}}collapsed{{/if}}"></i>
                <h4 class="rank-title m-text-xl m-bold m-color-dim">{{group.label}}</h4>
                <span class="rank-count-badge m-text-xs m-bold m-color-normal">{{group.spellCount}}</span>
              </div>
            </div>

            <div class="m-group-list spell-list {{#if group.isCollapsed}}collapsed{{/if}}">
              {{#each group.spells as |staffSpell|}}
              {{#> "modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs" spell=staffSpell rank=group.rank showChargeCost=true}}
                {{!-- Slots can only use the card's parameters (spell, rank) and @root, see spell-card.hbs --}}
                {{#*inline "lineButtons"}}
  <!--                {{#if spell.hasDamage}}-->
  <!--                <button type="button" class="btn-spell-damage m-compact m-inline-flex m-align-center m-justify-center m-gap-4 m-text-md m-semibold m-color-strong {{#if spell.isHealingOnly}}btn-spell-heal{{/if}}" data-action="rollSpellDamage" data-item-id="{{spell.id}}" data-entry-id="{{spell.entryId}}" data-rank="{{rank}}" title="Roll {{#if spell.isHealingOnly}}Healing{{else}}Damage{{/if}} for {{spell.name}} (Rank {{spell.effectiveCastRank}}){{#if spell.damageFormula}}: {{spell.damageFormula}}{{/if}}">-->
  <!--                  {{#if spell.isHealingOnly}}-->
  <!--                    <i class="fas fa-heart-pulse"></i> Heal-->
  <!--                  {{else}}-->
  <!--                    <i class="fas fa-burst"></i> Dmg-->
  <!--                  {{/if}}-->
  <!--                </button>-->
  <!--                {{/if}}-->

                  {{> "modules/pf2e-mobile-compact/templates/parts/spells/staff-line-cast-button.hbs" spell=spell rank=rank staffId=@root.activations.staff.id}}
                {{/inline}}

                {{#*inline "drawerButtons"}}
                  {{!-- Both ways to cast; only shown when there are two (see staff-line-cast-button.hbs) --}}
                  {{#if (and spell.hasSpontaneousOption (not spell.isCantrip))}}
                  {{> "modules/pf2e-mobile-compact/templates/parts/spells/staff-cast-buttons.hbs" spell=spell rank=rank staffId=@root.activations.staff.id}}
                  {{/if}}
                {{/inline}}
              {{/"modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs"}}
              {{/each}}
            </div>
          </section>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Wands, scrolls and other item spells use the Spells tab's spell card (spells/spell-card.hbs):
          the spell's name, tags and drawer with its description. The item's own data (rank, uses, quantity,
          entry) comes in through detailTags, the Cast button through lineButtons. Inside those slots only
          the card's parameters are available, so the wand or scroll is passed as "item". A wand or scroll
          without a spell (a blank scroll) gets a plain card with its name. --}}
    {{#if activations.wands.length}}
    <section class="m-group spell-rank-group">
      <div class="spell-rank-header m-flex-row m-align-center m-gap-8">
        <h3 class="rank-title m-flex-row m-align-center m-gap-6 m-text-xl m-bold m-color-accent"><i class="fas fa-wand-sparkles"></i> Wands</h3>
        <span class="rank-count-badge m-text-xs m-bold m-color-normal">{{activations.wands.length}}</span>
      </div>
      <div class="m-group-list spell-list">
        {{#each activations.wands as |wand|}}
        {{#if wand.spell}}
        {{#> "modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs" spell=wand.spell rank=wand.rank item=wand sourceItemId=wand.id sourceItemName=wand.name}}
          {{#*inline "detailTags"}}
          <span class="item-rank-badge m-badge-neutral m-text-xs m-semibold m-color-strong" title="Rank of the spell in this item">Rank {{item.rank}}</span>
          <span class="wand-uses-badge m-badge m-text-sm {{#if item.isOvercharged}}badge-expended{{/if}}">{{#if item.isOvercharged}}Overcharged{{else}}{{item.uses.value}} / {{item.uses.max}} Uses{{/if}}</span>
          {{/inline}}
          {{#*inline "lineButtons"}}
          <button type="button" class="btn-cast btn-cast-item m-inline-flex m-align-center m-justify-center m-text-base" data-action="castItemSpell" data-item-type="wand" data-item-id="{{item.id}}" data-entry-id="{{item.entryId}}" title="Cast from {{item.name}}">
            <i class="fas fa-wand-magic"></i>
          </button>
          {{/inline}}
        {{/"modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs"}}
        {{else}}
        {{> activationItemWithoutSpell item=wand itemType="wand"}}
        {{/if}}
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if activations.scrolls.length}}
    <section class="m-group spell-rank-group">
      <div class="spell-rank-header m-flex-row m-align-center m-gap-8">
        <h3 class="rank-title m-flex-row m-align-center m-gap-6 m-text-xl m-bold m-color-accent"><i class="fas fa-scroll"></i> Scrolls</h3>
        <span class="rank-count-badge m-text-xs m-bold m-color-normal">{{activations.scrolls.length}}</span>
      </div>
      <div class="m-group-list spell-list">
        {{#each activations.scrolls as |scroll|}}
        {{#if scroll.spell}}
        {{#> "modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs" spell=scroll.spell rank=scroll.rank item=scroll sourceItemId=scroll.id sourceItemName=scroll.name}}
          {{#*inline "detailTags"}}
          <span class="item-rank-badge m-badge-neutral m-text-xs m-semibold m-color-strong" title="Rank of the spell in this item">Rank {{item.rank}}</span>
          {{#if (gt item.quantity 1)}}<span class="quantity-badge m-badge m-text-sm m-color-normal">x{{item.quantity}}</span>{{/if}}
          {{/inline}}
          {{#*inline "lineButtons"}}
          <button type="button" class="btn-cast btn-cast-item m-inline-flex m-align-center m-justify-center m-text-base" data-action="castItemSpell" data-item-type="scroll" data-item-id="{{item.id}}" data-entry-id="{{item.entryId}}" title="Cast and use up 1 {{item.name}}">
            <i class="fas fa-scroll"></i>
          </button>
          {{/inline}}
        {{/"modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs"}}
        {{else}}
        {{> activationItemWithoutSpell item=scroll itemType="scroll"}}
        {{/if}}
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if activations.other.length}}
    <section class="m-group spell-rank-group">
      <div class="spell-rank-header m-flex-row m-align-center m-gap-8">
        <h3 class="rank-title m-flex-row m-align-center m-gap-6 m-text-xl m-bold m-color-accent"><i class="fas fa-gem"></i> Other Item Spells</h3>
        <span class="rank-count-badge m-text-xs m-bold m-color-normal">{{activations.other.length}}</span>
      </div>
      <div class="m-group-list spell-list">
        {{#each activations.other as |act|}}
        {{#> "modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs" spell=act.spell rank=act.spell.effectiveCastRank item=act}}
          {{#*inline "detailTags"}}
          <span class="detail-tag m-badge">{{item.entryName}}</span>
          {{/inline}}
          {{#*inline "lineButtons"}}
          {{> "modules/pf2e-mobile-compact/templates/parts/spells/cast-button.hbs" spell=spell rank=rank}}
          {{/inline}}
        {{/"modules/pf2e-mobile-compact/templates/parts/spells/spell-card.hbs"}}
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#unless hasActivations}}
    <p class="empty-hint">No staves, wands, scrolls, or item-granted spells found on this character.</p>
    {{/unless}}
  </div>
  {{/if}}
</div>
