<div class="mobile-chat-container m-flex-col" data-tab="chat">
  <!-- Foundry ui.chat.element will be docked here dynamically -->
  <div class="mobile-chat-mount m-flex-col"></div>

  <!-- Floating button to jump down to the latest message -->
  <button
    type="button"
    class="btn-scroll-bottom touch-target is-hidden m-inline-flex m-align-center m-justify-center m-gap-6 m-text-base m-semibold"
    data-action="scrollChatToBottom"
    title="Scroll to Latest Message"
    aria-label="Scroll to Latest Message"
  >
    <i class="fas fa-arrow-down"></i>
    <span>Latest</span>
  </button>
</div>
