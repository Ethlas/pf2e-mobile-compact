<div class="tab-pane actions-tab" data-tab="actions">
  <!-- Sub-Navigation for Action Mode: Encounter, Exploration, Downtime -->
  <div class="action-subtabs">
    <button type="button" class="touch-target subtab-btn {{#if (eq actionSubTab "encounter")}}active{{/if}}" data-action="switchActionSubTab" data-subtab="encounter">
      ⚔️ Encounter
    </button>
    <button type="button" class="touch-target subtab-btn {{#if (eq actionSubTab "exploration")}}active{{/if}}" data-action="switchActionSubTab" data-subtab="exploration">
      🧭 Exploration
    </button>
    <button type="button" class="touch-target subtab-btn {{#if (eq actionSubTab "downtime")}}active{{/if}}" data-action="switchActionSubTab" data-subtab="downtime">
      ⛺ Downtime
    </button>
  </div>

  {{#if (eq actionSubTab "encounter")}}
    <!-- 1. Strikes & Attacks Section -->
    <section class="actions-section">
      <h3 class="section-title"><i class="fas fa-fist-raised"></i> Attacks</h3>
      <div class="strikes-list">
        {{#each strikes as |strike index|}}
        <div class="action-card strike-card">
          <!-- Strike Header: Weapon Image, Name, Glyph, Traits, Badge -->
          <div class="strike-card-header">
            <img class="strike-img" src="{{strike.img}}" alt="{{strike.label}}" />
            <div class="strike-title-group">
              <div class="strike-name-row">
                <span class="action-cost-glyph">{{strike.glyph}}</span>
                <span class="action-name"><strong>{{strike.label}}</strong></span>
              </div>
              {{#if strike.traits.length}}
              <div class="action-traits strike-traits">
                {{#each strike.traits as |trait|}}
                <span class="trait-badge">{{trait.label}}</span>
                {{/each}}
              </div>
              {{/if}}
            </div>
            <span class="action-type-badge">{{strike.type}}</span>
          </div>

          <!-- MAP Variants at the TOP (Prominent attack row) -->
          <div class="strike-map-row">
            {{#each strike.variants as |variant vIndex|}}
            <button type="button" class="touch-target map-button" data-action="executeStrike" data-strike-index="{{index}}" data-variant-index="{{vIndex}}" title="Attack Variant {{vIndex}}">
              {{variant.label}}
            </button>
            {{/each}}
          </div>

          <!-- Damage and Critical Buttons Row -->
          <div class="strike-damage-row">
            {{#if strike.damage}}
            <button type="button" class="touch-target variant-button damage-button" data-action="executeDamage" data-strike-index="{{index}}" title="Roll Damage">
              💥 {{strike.damageFormula}}
            </button>
            {{/if}}

            {{#if strike.critical}}
            <button type="button" class="touch-target variant-button critical-button" data-action="executeCritical" data-strike-index="{{index}}" title="Roll Critical Damage">
              ⚡ Crit
            </button>
            {{/if}}
          </div>

          <!-- Weapon Auxiliary Actions: Draw, Sheathe, Drop, Reload, Change Grip -->
          {{#if strike.hasAuxiliary}}
          <div class="strike-auxiliary-row">
            {{#each strike.auxiliaryActions as |aux|}}
            <button type="button" class="touch-target aux-action-btn" data-action="executeAuxiliaryAction" data-strike-index="{{index}}" data-aux-index="{{aux.index}}" title="{{aux.label}}">
              {{#if aux.glyph}}
              <span class="aux-glyph">{{aux.glyph}}</span>
              {{/if}}
              <span class="aux-label">{{aux.label}}</span>
              {{#if aux.annotation}}
              <span class="aux-annotation">({{aux.annotation}})</span>
              {{/if}}
            </button>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="empty-hint">No strikes configured on this character.</p>
        {{/each}}
      </div>
    </section>

    <!-- 2. Actions (from feats etc.) -->
    {{#if characterActions.actions.length}}
    <section class="actions-section">
      <h3 class="section-title"><i class="fas fa-bolt"></i> Actions</h3>
      <div class="character-actions-list">
        {{#each characterActions.actions as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              <span class="action-cost-glyph">{{act.glyph}}</span>
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Action{{/if}}">
                {{#if act.active}}Active{{else}}Use{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.frequency}}
          <div class="action-frequency">
            <span>Uses: {{act.frequency.value}} / {{act.frequency.max}} {{act.frequency.per}}</span>
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- 3. Reactions -->
    {{#if characterActions.reactions.length}}
    <section class="actions-section">
      <h3 class="section-title"><i class="fas fa-rotate-left"></i> Reactions</h3>
      <div class="character-actions-list">
        {{#each characterActions.reactions as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              <span class="action-cost-glyph glyph-reaction">⬢</span>
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Reaction{{/if}}">
                {{#if act.active}}Active{{else}}Use{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- 4. Free Actions -->
    {{#if characterActions.free.length}}
    <section class="actions-section">
      <h3 class="section-title"><i class="far fa-circle"></i> Free Actions</h3>
      <div class="character-actions-list">
        {{#each characterActions.free as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              <span class="action-cost-glyph glyph-free">◇</span>
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Action{{/if}}">
                {{#if act.active}}Active{{else}}Use{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- 5. Skill actions (those that are possible because of skills) -->
    {{#if characterActions.skillActions.length}}
    <section class="actions-section skill-actions-section">
      <h3 class="section-title"><i class="fas fa-book-sparkles"></i> Skill Actions</h3>
      <div class="character-actions-list">
        {{#each characterActions.skillActions as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              {{#if act.glyph}}
              <span class="action-cost-glyph">{{act.glyph}}</span>
              {{/if}}
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Action{{/if}}">
                {{#if act.active}}Active{{else}}Use{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll{{#if act.multiActionLabel}} ({{act.multiActionLabel}}){{/if}}
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

  {{else if (eq actionSubTab "exploration")}}
    <!-- Exploration Activities Tab -->
    <section class="actions-section">
      <h3 class="section-title"><i class="fas fa-compass"></i> Exploration Activities</h3>
      <div class="character-actions-list">
        {{#each characterActions.exploration as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              {{#if act.glyph}}
              <span class="action-cost-glyph">{{act.glyph}}</span>
              {{/if}}
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Activity{{/if}}">
                {{#if act.active}}Active{{else}}Use{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="empty-hint">No exploration activities configured on this character.</p>
        {{/each}}
      </div>
    </section>

  {{else if (eq actionSubTab "downtime")}}
    <!-- Downtime Activities Tab -->
    <section class="actions-section">
      <h3 class="section-title"><i class="fas fa-campground"></i> Downtime Activities</h3>
      <div class="character-actions-list">
        {{#each characterActions.downtime as |act|}}
        <div class="action-card character-action-card {{#if act.isExpanded}}expanded{{/if}}" data-item-id="{{act.id}}">
          <div class="action-card-header">
            <div class="action-title-group touch-target" data-action="toggleActionSummary" data-item-id="{{act.id}}" title="Toggle Description">
              {{#if act.glyph}}
              <span class="action-cost-glyph">{{act.glyph}}</span>
              {{/if}}
              <span class="action-name"><strong>{{act.name}}</strong></span>
              {{#if act.description}}
              <i class="fas fa-chevron-down action-expand-icon {{#if act.isExpanded}}expanded{{/if}}"></i>
              {{/if}}
            </div>
            <div class="action-btn-group">
              <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{act.id}}" title="Send to Chat">
                <i class="fas fa-message"></i>
              </button>
              {{#if act.usable}}
              <button type="button" class="touch-target btn-action-use {{#if act.active}}active{{/if}}" data-action="useAction" data-item-id="{{act.id}}" title="{{#if act.active}}Deactivate{{else}}Use Activity{{/if}}">
                {{#if act.active}}Active{{else}}Use{{/if}}
              </button>
              {{/if}}
              {{#if act.hasRoll}}
              <button type="button" class="touch-target btn-action-roll {{#if act.isAttack}}btn-action-attack{{/if}}" data-action="rollActionCheck" data-item-id="{{act.id}}" data-action-slug="{{act.slug}}" title="{{#if act.isAttack}}Attack{{else}}Roll Check{{/if}}">
                {{#if act.isAttack}}
                  <i class="fas fa-crosshairs"></i> Attack
                {{else}}
                  <i class="fas fa-dice-d20"></i> Roll
                {{/if}}
              </button>
              {{/if}}
            </div>
          </div>

          {{#if act.traits.length}}
          <div class="action-traits">
            {{#each act.traits as |trait|}}
            <span class="trait-badge">{{trait.label}}</span>
            {{/each}}
          </div>
          {{/if}}

          {{#if act.description}}
          <div class="action-summary {{#if act.isExpanded}}expanded{{else}}collapsed{{/if}}">
            <div class="action-description-content">
              {{{act.description}}}
            </div>
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="empty-hint">No downtime activities configured on this character.</p>
        {{/each}}
      </div>
    </section>
  {{/if}}
</div>
