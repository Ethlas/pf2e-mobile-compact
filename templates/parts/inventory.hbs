<div class="tab-pane inventory-tab" data-tab="inventory">
  <!-- Bulk & Encumbrance Status Bar -->
  <div class="inventory-status-bar m-flex-row m-align-center m-justify-between">
    <div class="bulk-info">
      <span>Bulk: <strong>{{encumbrance.bulk}} / {{encumbrance.max}}</strong></span>
      {{#if encumbrance.isEncumbered}}
      <span class="encumbered-badge warning">Encumbered</span>
      {{/if}}
      {{#if encumbrance.isOverLimit}}
      <span class="encumbered-badge danger">Over Limit</span>
      {{/if}}
    </div>
    <div class="m-flex-row m-align-center m-gap-6">
      {{#if partyStash}}
      <button type="button" class="touch-target btn-party-stash m-inline-flex m-align-center m-gap-4" data-action="openPartyStash" data-party-id="{{partyStash.id}}" title="Open {{partyStash.name}} Stash">
        <i class="fas fa-box-archive"></i> Stash ({{partyStash.itemsCount}})
      </button>
      {{/if}}
      <button type="button" class="touch-target btn-primary" data-action="openCompendiumPicker" data-type="equipment">
        <i class="fas fa-plus"></i> Add Gear
      </button>
    </div>
  </div>

  <!-- Consumables Section -->
  <section class="m-group inventory-section">
    <h3 class="section-title touch-header" data-action="toggleInventorySection" data-section="consumables">
      <span><i class="fas fa-flask"></i> Consumables ({{inventory.consumables.length}})</span>
      <i class="fas fa-chevron-down section-expand-icon {{#if inventory.isConsumablesCollapsed}}collapsed{{/if}}"></i>
    </h3>
    {{#unless inventory.isConsumablesCollapsed}}
    <div class="m-group-list inventory-list">
      {{#each inventory.consumables as |consumable|}}
      {{#> "modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs" item=consumable showQuantity=true}}
      {{!-- Slots can only use the card's parameters (item) and @root, see inventory/item-card.hbs --}}
        {{#*inline "badges"}}
          <span class="item-badge category-badge m-inline-flex m-align-center m-gap-4">{{item.categoryLabel}}</span>
          {{#if item.hasUses}}
          <span class="item-badge uses-badge m-inline-flex m-align-center m-gap-4">{{item.uses.value}}/{{item.uses.max}} uses</span>
          {{/if}}
        {{/inline}}
        {{#*inline "lineButtons"}}
          {{#if item.canApplyToWeapon}}
          <button type="button" class="touch-target btn-apply-poison m-inline-flex m-align-center m-justify-center m-gap-4" data-action="applyPoison" data-item-id="{{item.id}}" title="Apply to Weapon">
            <i class="fas fa-vial"></i> Apply
          </button>
          {{else}}
          <button type="button" class="touch-target btn-consume" data-action="consumeItem" data-item-id="{{item.id}}" title="Use or Administer to Comrade">
            <i class="fas fa-hand-holding-heart"></i> Use
          </button>
          {{/if}}
        {{/inline}}
      {{/"modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs"}}
      {{else}}
      <p class="empty-hint">No consumable items.</p>
      {{/each}}
    </div>
    {{/unless}}
  </section>

  <!-- Weapons Section -->
  <section class="m-group inventory-section">
    <h3 class="section-title touch-header" data-action="toggleInventorySection" data-section="weapons">
      <span><i class="fas fa-sword"></i> Weapons ({{inventory.weapons.length}})</span>
      <i class="fas fa-chevron-down section-expand-icon {{#if inventory.isWeaponsCollapsed}}collapsed{{/if}}"></i>
    </h3>
    {{#unless inventory.isWeaponsCollapsed}}
    <div class="m-group-list inventory-list">
      {{#each inventory.weapons as |weapon|}}
      {{#> "modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs" item=weapon showBulk=true}}
      {{!-- Slots can only use the card's parameters (item) and @root, see inventory/item-card.hbs --}}
        {{#*inline "badges"}}
          <button type="button" class="touch-target badge-btn carry-badge {{item.carryType}}" data-action="changeCarryType" data-item-id="{{item.id}}" title="Tap to toggle carry state">
            {{item.carryLabel}}
          </button>
          {{#if item.runesSummary}}
          <span class="item-badge runes-badge m-inline-flex m-align-center m-gap-4" title="Runes: {{item.runesSummary}}">
            <i class="fas fa-gem"></i> {{item.runesSummary}}
          </span>
          {{/if}}
          {{#if item.isInvestable}}
          <button type="button" class="touch-target badge-btn invest-badge {{#if item.isInvested}}invested{{/if}}" data-action="toggleInvested" data-item-id="{{item.id}}" title="Toggle Investiture">
            <i class="fas fa-sparkles"></i> {{#if item.isInvested}}Invested{{else}}Invest{{/if}}
          </button>
          {{/if}}
          {{#if item.isPoisoned}}
          <span class="item-badge poison-badge m-inline-flex m-align-center m-gap-4" title="Poisoned: {{item.poison.name}}">
            <i class="fas fa-skull-crossbones"></i> {{item.poison.name}}
          </span>
          {{/if}}
        {{/inline}}
        {{#*inline "drawerButtons"}}
          {{#if item.canHaveRunes}}
          <button type="button" class="touch-target btn-runes m-inline-flex m-align-center m-justify-center m-gap-4" data-action="configureRunes" data-item-id="{{item.id}}" title="Configure Runes">
            <i class="fas fa-gem"></i> Runes
          </button>
          {{/if}}
          {{#if item.isPoisoned}}
          <button type="button" class="touch-target btn-detach-subitem m-inline-flex m-align-center m-justify-center m-gap-4" data-action="detachSubitem" data-weapon-id="{{item.id}}" data-subitem-id="{{item.poison.id}}" title="Clean / Detach Poison">
            <i class="fas fa-eraser"></i> Clean
          </button>
          {{/if}}
        {{/inline}}
      {{/"modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs"}}
      {{else}}
      <p class="empty-hint">No weapons equipped or carried.</p>
      {{/each}}
    </div>
    {{/unless}}
  </section>

  <!-- Armor Section -->
  <section class="m-group inventory-section">
    <h3 class="section-title touch-header" data-action="toggleInventorySection" data-section="armor">
      <span><i class="fas fa-shield-alt"></i> Armor &amp; Shields ({{inventory.armor.length}})</span>
      <i class="fas fa-chevron-down section-expand-icon {{#if inventory.isArmorCollapsed}}collapsed{{/if}}"></i>
    </h3>
    {{#unless inventory.isArmorCollapsed}}
    <div class="m-group-list inventory-list">
      {{#each inventory.armor as |armorItem|}}
      {{#> "modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs" item=armorItem showBulk=true}}
      {{!-- Slots can only use the card's parameters (item) and @root, see inventory/item-card.hbs --}}
        {{#*inline "badges"}}
          {{#if item.isShield}}
          <span class="item-badge shield-badge m-inline-flex m-align-center m-gap-4"><i class="fas fa-shield-halved"></i> {{item.hp}}/{{item.maxHp}} HP</span>
          {{else}}
          <span class="item-badge armor-badge m-inline-flex m-align-center m-gap-4">+{{item.acBonus}} AC</span>
          {{/if}}
          <button type="button" class="touch-target badge-btn equip-badge {{#if item.isEquipped}}equipped{{/if}}" data-action="toggleEquipped" data-item-id="{{item.id}}" title="Toggle Equipped / Worn">
            <i class="fas fa-shirt"></i> {{item.equipLabel}}
          </button>
          {{#if item.runesSummary}}
          <span class="item-badge runes-badge m-inline-flex m-align-center m-gap-4" title="Runes: {{item.runesSummary}}">
            <i class="fas fa-gem"></i> {{item.runesSummary}}
          </span>
          {{/if}}
          {{#if item.isInvestable}}
          <button type="button" class="touch-target badge-btn invest-badge {{#if item.isInvested}}invested{{/if}}" data-action="toggleInvested" data-item-id="{{item.id}}" title="Toggle Investiture">
            <i class="fas fa-sparkles"></i> {{#if item.isInvested}}Invested{{else}}Invest{{/if}}
          </button>
          {{/if}}
        {{/inline}}
        {{#*inline "drawerButtons"}}
          {{#if item.canHaveRunes}}
          <button type="button" class="touch-target btn-runes m-inline-flex m-align-center m-justify-center m-gap-4" data-action="configureRunes" data-item-id="{{item.id}}" title="Configure Runes">
            <i class="fas fa-gem"></i> Runes
          </button>
          {{/if}}
        {{/inline}}
      {{/"modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs"}}
      {{else}}
      <p class="empty-hint">No armor equipped.</p>
      {{/each}}
    </div>
    {{/unless}}
  </section>

  <!-- Other Gear Section -->
  <section class="m-group inventory-section">
    <h3 class="section-title touch-header" data-action="toggleInventorySection" data-section="gear">
      <span><i class="fas fa-backpack"></i> Other Gear ({{inventory.gear.length}})</span>
      <i class="fas fa-chevron-down section-expand-icon {{#if inventory.isGearCollapsed}}collapsed{{/if}}"></i>
    </h3>
    {{#unless inventory.isGearCollapsed}}
    <div class="m-group-list inventory-list">
      {{#each inventory.gear as |gearItem|}}
      {{#> "modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs" item=gearItem showQuantity=true showBulk=true}}
      {{!-- Slots can only use the card's parameters (item) and @root, see inventory/item-card.hbs --}}
        {{#*inline "badges"}}
          {{#if item.canBeWorn}}
          <button type="button" class="touch-target badge-btn equip-badge {{#if item.isEquipped}}equipped{{/if}}" data-action="toggleEquipped" data-item-id="{{item.id}}" title="Toggle Worn / Stowed">
            <i class="fas fa-shirt"></i> {{item.equipLabel}}
          </button>
          {{/if}}
          {{#if item.isInvestable}}
          <button type="button" class="touch-target badge-btn invest-badge {{#if item.isInvested}}invested{{/if}}" data-action="toggleInvested" data-item-id="{{item.id}}" title="Toggle Investiture">
            <i class="fas fa-sparkles"></i> {{#if item.isInvested}}Invested{{else}}Invest{{/if}}
          </button>
          {{/if}}
          {{#if item.isContainer}}
          <span class="item-badge container-badge m-inline-flex m-align-center m-gap-4"><i class="fas fa-box-open"></i> Container ({{item.heldItemsCount}})</span>
          {{/if}}
          {{#if item.isStowed}}
          <span class="item-badge stowed-badge m-inline-flex m-align-center m-gap-4"><i class="fas fa-box"></i> in {{item.containerName}}</span>
          {{/if}}
        {{/inline}}
      {{/"modules/pf2e-mobile-compact/templates/parts/inventory/item-card.hbs"}}
      {{else}}
      <p class="empty-hint">No other gear carried.</p>
      {{/each}}
    </div>
    {{/unless}}
  </section>
</div>
