{{!--
  Character overview: opened with the user button next to the name in the header (not a footer tab).
  Data comes from prepareCharacterContext() in sheet-helpers/context-character.js.
  Effects are listed like pf2e's effects panel; feats in pf2e's own groups, with granted feats
  indented under the feat that grants them.
--}}
{{!-- One feat or effect: tapping the line opens its description drawer (toggleItemDescription,
      character-handlers.js), which is filled on the first tap. Send to Chat keeps its own action.
      Feats show their level in front of the name; effects show their badge value and remaining duration. --}}
{{#*inline "itemLine"}}
<div class="character-item {{#if isChild}}character-item-child{{/if}} {{#if entry.isExpanded}}expanded{{/if}}" data-item-id="{{entry.id}}">
  <div class="m-card-line m-flex-row character-item-line" data-action="toggleItemDescription" title="{{entry.name}}">
    {{#unless isEffect}}<span class="character-item-level">{{entry.level}}</span>{{/unless}}
    <span class="action-name">{{#if isChild}}{{entry.name}}{{else}}<strong>{{entry.name}}</strong>{{/if}}{{#if entry.badge}} {{entry.badge}}{{/if}}</span>
    {{#if entry.remaining}}<span class="character-item-remaining">{{entry.remaining}}</span>{{/if}}
    <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{entry.id}}" title="Send to Chat">
      <i class="fas fa-message"></i>
    </button>
  </div>
  <div class="action-summary {{#if entry.isExpanded}}expanded{{else}}collapsed{{/if}}">
    <div class="action-description-content">{{{entry.description}}}</div>
    <em class="character-item-no-description">No description.</em>
  </div>
</div>
{{/inline}}
<div class="tab-pane character-tab" data-tab="character">
  <!-- Identity: ancestry, heritage, background, class & level, deity, size -->
  <section class="m-group actions-section">
    <h3 class="section-title"><i class="fas fa-user"></i> {{actor.name}}</h3>
    <dl class="character-facts">
      {{#with character.identity as |id|}}
      {{#if id.ancestry}}<dt>Ancestry</dt><dd>{{id.ancestry}}</dd>{{/if}}
      {{#if id.heritage}}<dt>Heritage</dt><dd>{{id.heritage}}</dd>{{/if}}
      {{#if id.background}}<dt>Background</dt><dd>{{id.background}}</dd>{{/if}}
      {{#if id.className}}<dt>Class</dt><dd>{{id.className}} {{id.level}}</dd>{{/if}}
      {{#if id.deity}}<dt>Deity</dt><dd>{{id.deity}}</dd>{{/if}}
      {{#if id.size}}<dt>Size</dt><dd>{{id.size}}</dd>{{/if}}
      {{/with}}
    </dl>
  </section>

  <!-- Effects: afflictions, conditions and effects, like pf2e's effects panel -->
  {{#if character.effects.length}}
  <section class="m-group actions-section character-effects">
    <h3 class="section-title"><i class="fas fa-bolt"></i> Effects</h3>
    <div class="m-group-list">
      {{#each character.effects as |effect|}}
      <div class="m-card">
        {{> itemLine entry=effect isEffect=true}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- Attributes, speeds, senses, languages -->
  <section class="m-group actions-section">
    <h3 class="section-title"><i class="fas fa-dumbbell"></i> Attributes</h3>
    <div class="character-attributes">
      {{#each character.attributes as |attr|}}
      <div class="character-attribute" title="{{attr.title}}">
        <span class="character-attribute-label">{{attr.key}}</span>
        <span class="character-attribute-mod">{{#if (gte attr.mod 0)}}+{{/if}}{{attr.mod}}</span>
      </div>
      {{/each}}
    </div>
    <dl class="character-facts">
      {{#if character.speeds.length}}
      <dt>Speed</dt><dd>{{#each character.speeds as |speed|}}{{#unless @first}}, {{/unless}}{{speed.label}} {{speed.value}} ft{{/each}}</dd>
      {{/if}}
      {{#if character.senses.length}}
      <dt>Senses</dt><dd>{{#each character.senses as |sense|}}{{#unless @first}}, {{/unless}}{{sense}}{{/each}}</dd>
      {{/if}}
      {{#if character.languages.length}}
      <dt>Languages</dt><dd>{{#each character.languages as |language|}}{{#unless @first}}, {{/unless}}{{language}}{{/each}}</dd>
      {{/if}}
    </dl>
  </section>

  <!-- Defense details not already in the header: IWR and class DC -->
  <section class="m-group actions-section">
    <h3 class="section-title"><i class="fas fa-shield-halved"></i> Defenses</h3>
    <dl class="character-facts">
      {{#if character.defenses.classDC}}
      <dt>Class DC</dt><dd>{{character.defenses.classDC}}</dd>
      {{/if}}
      {{#if character.defenses.immunities.length}}
      <dt>Immunities</dt><dd>{{#each character.defenses.immunities as |entry|}}{{#unless @first}}, {{/unless}}{{entry}}{{/each}}</dd>
      {{/if}}
      {{#if character.defenses.weaknesses.length}}
      <dt>Weaknesses</dt><dd>{{#each character.defenses.weaknesses as |entry|}}{{#unless @first}}, {{/unless}}{{entry}}{{/each}}</dd>
      {{/if}}
      {{#if character.defenses.resistances.length}}
      <dt>Resistances</dt><dd>{{#each character.defenses.resistances as |entry|}}{{#unless @first}}, {{/unless}}{{entry}}{{/each}}</dd>
      {{/if}}
    </dl>
  </section>

  <!-- Feats & features, one frame per pf2e feat group -->
  {{#each character.featGroups as |group|}}
  <section class="m-group actions-section character-feat-group">
    <h3 class="section-title"><i class="fas fa-medal"></i> {{group.label}}</h3>
    <div class="m-group-list">
      {{#each group.feats as |feat|}}
      <div class="m-card">
        {{> itemLine entry=feat}}
        {{#each feat.children as |child|}}
        {{> itemLine entry=child isChild=true}}
        {{/each}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
