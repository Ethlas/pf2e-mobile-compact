{{!--
  Character overview: opened with the user button next to the name in the header (not a footer tab).
  Data comes from prepareCharacterContext() in sheet-helpers/context-character.js.
  Order: who the character is (name, class, traits, ancestry ...), what is affecting them now (effects),
  their numbers (attributes, speeds, senses, languages, defenses), and last the long list of feats in
  pf2e's own groups, with granted feats indented under the feat that grants them.
--}}
{{!-- One feat or effect: tapping the line opens its description drawer (toggleItemDescription,
      character-handlers.js), which is filled on the first tap. Send to Chat is inside the drawer, like the
      action cards. Feats show their level in front of the name; effects show their pf2e icon, badge value
      and remaining duration. --}}
{{#*inline "itemLine"}}
<div class="character-item {{#if isChild}}character-item-child{{/if}} {{#if entry.isExpanded}}expanded{{/if}}" data-item-id="{{entry.id}}">
  <div class="m-card-line character-item-line m-flex-row m-align-center m-gap-8" data-action="toggleItemDescription" title="{{entry.name}}">
    {{#if isEffect}}
    {{#if entry.img}}<img class="character-item-img m-shrink-0" src="{{entry.img}}" alt="">{{/if}}
    {{else}}
    <span class="character-item-level m-shrink-0">{{entry.level}}</span>
    {{/if}}
    <span class="action-name m-flex-col m-flex-auto m-min-w-0">
      <span class="character-item-name">{{#if isChild}}{{entry.name}}{{else}}<strong>{{entry.name}}</strong>{{/if}}{{#if entry.badge}} {{entry.badge}}{{/if}}</span>
      {{#if entry.remaining}}<span class="character-item-remaining">{{entry.remaining}}</span>{{/if}}
    </span>
  </div>
  <div class="action-summary {{#if entry.isExpanded}}expanded{{else}}collapsed{{/if}}">
    <div class="m-drawer-row m-flex-row">
      <button type="button" class="touch-target btn-action-chat" data-action="itemToChat" data-item-id="{{entry.id}}" title="Send to Chat">
        <i class="fas fa-message"></i> Chat
      </button>
    </div>
    <div class="action-description-content">{{{entry.description}}}</div>
    <em class="character-item-no-description">No description.</em>
  </div>
</div>
{{/inline}}
{{!-- A list of short labels (traits, senses, languages, IWR) as tags --}}
{{#*inline "tagList"}}
<ul class="character-tags m-flex-row m-wrap m-gap-4">
  {{#each tags as |tag|}}<li class="character-tag {{../tagClass}}">{{tag}}</li>{{/each}}
</ul>
{{/inline}}
<div class="tab-pane character-tab" data-tab="character">
  <!-- Identity: name with class and level, traits, then ancestry, heritage, background and deity in two columns -->
  {{#with character.identity as |id|}}
  <section class="m-group actions-section character-identity">
    <h3 class="section-title m-flex-row m-align-baseline m-justify-between m-gap-8">
      <span class="character-title-name m-min-w-0"><i class="fas fa-user"></i> {{@root.actor.name}}</span>
      {{#if id.className}}<span class="character-title-class m-shrink-0">{{id.className}} {{id.level}}</span>{{/if}}
    </h3>
    {{#if (or id.size id.traits.length)}}
    <ul class="character-tags m-flex-row m-wrap m-gap-4">
      {{#if id.size}}<li class="character-tag character-tag-size">{{id.size}}</li>{{/if}}
      {{#each id.traits as |trait|}}<li class="character-tag character-tag-trait">{{trait}}</li>{{/each}}
    </ul>
    {{/if}}
    <dl class="character-details">
      {{#if id.ancestry}}<div><dt>Ancestry</dt><dd>{{id.ancestry}}</dd></div>{{/if}}
      {{#if id.heritage}}<div><dt>Heritage</dt><dd>{{id.heritage}}</dd></div>{{/if}}
      {{#if id.background}}<div><dt>Background</dt><dd>{{id.background}}</dd></div>{{/if}}
      {{#if id.deity}}<div><dt>Deity</dt><dd>{{id.deity}}</dd></div>{{/if}}
    </dl>
  </section>
  {{/with}}

  <!-- Effects: afflictions, conditions and effects, like pf2e's effects panel -->
  {{#if character.effects.length}}
  <section class="m-group actions-section character-effects">
    <h3 class="section-title"><i class="fas fa-bolt"></i> Effects</h3>
    <div class="m-group-list">
      {{#each character.effects as |effect|}}
      <div class="m-card">
        {{> itemLine entry=effect isEffect=true}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- Attributes, speeds, senses, languages and the defense details not already in the header (class DC, IWR) -->
  <section class="m-group actions-section character-stats">
    <h3 class="section-title"><i class="fas fa-dumbbell"></i> Attributes</h3>
    <div class="character-attributes">
      {{#each character.attributes as |attr|}}
      <div class="character-attribute m-flex-col m-align-center" title="{{attr.title}}">
        <span class="character-attribute-label">{{attr.key}}</span>
        <span class="character-attribute-mod">{{#if (gte attr.mod 0)}}+{{/if}}{{attr.mod}}</span>
      </div>
      {{/each}}
    </div>

    <h4 class="character-subtitle"><i class="fas fa-person-running"></i> Speeds</h4>
    <div class="character-speeds">
      {{#each character.speeds as |speed|}}
      <div class="m-flex-col m-align-center {{#unless speed.value}}character-speed-none{{/unless}}">
        <span class="character-speed-label">{{speed.label}}</span>
        <span class="character-speed-value">{{#if speed.value}}{{speed.value}} <small>ft</small>{{else}}&mdash;{{/if}}</span>
      </div>
      {{/each}}
    </div>

    {{#if character.senses.length}}
    <h4 class="character-subtitle"><i class="fas fa-eye"></i> Senses</h4>
    {{> tagList tags=character.senses}}
    {{/if}}

    {{#if character.languages.length}}
    <h4 class="character-subtitle"><i class="fas fa-language"></i> Languages</h4>
    {{> tagList tags=character.languages}}
    {{/if}}

    {{#with character.defenses as |def|}}
    {{#if (or def.classDC def.immunities.length def.weaknesses.length def.resistances.length)}}
    <h4 class="character-subtitle"><i class="fas fa-shield-halved"></i> Defenses</h4>
    <dl class="character-facts">
      {{#if def.classDC}}<dt>Class DC</dt><dd>{{def.classDC}}</dd>{{/if}}
      {{#if def.immunities.length}}<dt>Immunities</dt><dd>{{> tagList tags=def.immunities tagClass="character-tag-immunity"}}</dd>{{/if}}
      {{#if def.weaknesses.length}}<dt>Weaknesses</dt><dd>{{> tagList tags=def.weaknesses tagClass="character-tag-weakness"}}</dd>{{/if}}
      {{#if def.resistances.length}}<dt>Resistances</dt><dd>{{> tagList tags=def.resistances tagClass="character-tag-resistance"}}</dd>{{/if}}
    </dl>
    {{/if}}
    {{/with}}
  </section>

  <!-- Feats & features, one frame per pf2e feat group -->
  {{#each character.featGroups as |group|}}
  <section class="m-group actions-section character-feat-group">
    <h3 class="section-title"><i class="fas fa-medal"></i> {{group.label}}</h3>
    <div class="m-group-list">
      {{#each group.feats as |feat|}}
      <div class="m-card">
        {{> itemLine entry=feat}}
        {{#each feat.children as |child|}}
        {{> itemLine entry=child isChild=true}}
        {{/each}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
