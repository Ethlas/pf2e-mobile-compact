<header class="mobile-header-dashboard">
  <!-- Row 1: Identity & Controls Toolbar -->
  <div class="header-top-row">
    <div class="actor-identity-wrapper">
      {{#if hasMultipleCharacters}}
      <select class="actor-switcher touch-target" data-change-action="switchActor" title="Switch Character" aria-label="Switch Character">
        {{#each ownedCharacters as |char|}}
        <option value="{{char.id}}" {{#if (eq char.id ../actor.id)}}selected{{/if}}>
          👤 {{char.name}}
        </option>
        {{/each}}
      </select>
      {{else}}
      <span class="actor-name" title="{{actor.name}}">👤 {{actor.name}}</span>
      {{/if}}
    </div>

    <div class="header-controls-wrapper">
      <select name="target-select" class="touch-target header-target-select" data-change-action="selectTarget" aria-label="Select Target" title="Target Token">
        <option value="">🎯 No Target</option>
        {{#each targets}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
          🎯 {{this.name}}
        </option>
        {{/each}}
      </select>

      <select name="roll-mode" class="touch-target header-roll-mode-select" data-change-action="toggleRollMode" aria-label="Roll Mode" title="Roll Mode">
        <option value="digital" {{#if (eq rollMode "digital")}}selected{{/if}}>🎲 Digital</option>
        <option value="physical" {{#if (eq rollMode "physical")}}selected{{/if}}>✋ Physical</option>
      </select>

      <button type="button" class="touch-target btn-fullscreen" data-action="toggleFullscreen" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
        <i class="fas fa-expand"></i>
      </button>
    </div>
  </div>

  <!-- Row 2: Consolidated HP & Temp HP Streamlined Controls -->
  <div class="header-hp-row">
    <!-- Quick Delta Box (+/-) on Left -->
    <div class="hp-delta-group">
      <input type="text" class="hp-delta-input touch-target" data-change-action="applyDeltaHP" placeholder="±Amt" title="Enter damage (-) or heal (+) and press Enter (e.g. -5 or +5)" aria-label="HP Delta" />
    </div>

    <!-- Current & Max HP with Direct Edit -->
    <div class="hp-direct-group">
      <span class="hp-label">HP</span>
      <div class="hp-input-container">
        <input type="text" class="hp-current-input" data-change-action="setDirectHP" value="{{hp.value}}" title="Current HP (type number to set, or +/- to change)" aria-label="Current HP" />
        <span class="hp-slash">/</span>
        <span class="hp-max-value" title="Max HP">{{hp.max}}</span>
      </div>
    </div>

    <!-- Temp HP with Direct Edit -->
    <div class="temp-hp-direct-group">
      <span class="temp-hp-label">TEMP</span>
      <div class="temp-hp-input-container">
        <input type="text" class="temp-hp-current-input" data-change-action="setDirectTempHP" value="{{hp.temp}}" title="Temp HP (type number to set, or +/- to change)" aria-label="Temporary HP" />
      </div>
    </div>

    {{#if shield.hp.max}}
    <div class="shield-badge-group">
      <span class="defense-item shield-badge" title="Shield HP: {{shield.hp.value}}/{{shield.hp.max}} (Hardness {{shield.hardness}})">
        <strong>🛡️</strong> {{shield.hp.value}}/{{shield.hp.max}}
      </span>
    </div>
    {{/if}}
  </div>

  <!-- Row 3: Defenses, Saves & Perception/Initiative Pill Strip -->
  <div class="header-defenses-saves-row">
    <span class="defense-item ac-badge" title="Armor Class: {{defenses.ac.value}}">
      <strong>AC</strong> {{defenses.ac.value}}
    </span>

    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="fortitude" title="Roll Fortitude Save (+{{defenses.fortitude.mod}})">
      <strong>Fort</strong> +{{defenses.fortitude.mod}}
    </button>
    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="reflex" title="Roll Reflex Save (+{{defenses.reflex.mod}})">
      <strong>Ref</strong> +{{defenses.reflex.mod}}
    </button>
    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="will" title="Roll Will Save (+{{defenses.will.mod}})">
      <strong>Will</strong> +{{defenses.will.mod}}
    </button>

    <div class="perc-init-dropdown-wrapper">
      <select class="touch-target perception-init-select {{#if combat.active}}{{#if combat.hasRolled}}combat-rolled{{else}}combat-active{{/if}}{{/if}}" data-change-action="rollPerceptionOrInitiative" title="Roll Perception Check or Initiative" aria-label="Roll Perception or Initiative">
        <option value="" selected disabled>
          {{#if combat.active}}
            {{#if combat.hasRolled}}⚔️ {{combat.initiative}}{{else}}⚔️ Init{{/if}}
          {{else}}
            👁️ +{{defenses.perception.mod}}
          {{/if}}
        </option>
        <option value="perception">👁️ Perception (+{{defenses.perception.mod}})</option>
        <option value="initiative">⚔️ Initiative ({{#if combat.hasRolled}}{{combat.initiative}}{{else}}+{{initiative.mod}}{{/if}})</option>
      </select>
    </div>
  </div>
</header>
