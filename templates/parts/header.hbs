<header class="mobile-header-dashboard m-flex-col m-gap-6 m-shrink-0 {{#if isParty}}party-header{{/if}} {{#if isKingdom}}kingdom-header{{/if}}">
  <!-- Row 1: Identity & Controls Toolbar -->
  <div class="header-top-row">
    <div class="actor-identity-wrapper">
      {{!-- Character overview & feats: opens a view in the tab area instead of using a footer slot.
            It carries the 👤 that party and kingdom names have in front of them. --}}
      {{#unless (or isParty isKingdom)}}
      <button type="button" class="touch-target header-btn m-compact {{#if (eq activeTab "character")}}active{{/if}}" data-action="toggleCharacterOverview" title="Character overview & feats{{#if hasActiveEffects}} (effects active){{/if}}" aria-label="Character Overview">
        👤
        {{#if hasActiveEffects}}<span class="header-btn-badge"><i class="fas fa-bolt"></i></span>{{/if}}
      </button>
      {{/unless}}
      {{#if hasMultipleCharacters}}
      <select class="touch-target header-select actor-switcher m-compact m-truncate" data-change-action="switchActor" title="Switch Character / Party / Kingdom" aria-label="Switch Character">
        {{#each ownedCharacters as |char|}}
        <option value="{{char.id}}" {{#if char.selected}}selected{{/if}}>
          {{char.name}}
        </option>
        {{/each}}
      </select>
      {{else}}
      <span class="actor-name m-truncate" title="{{actor.name}}">{{#if isKingdom}}👑 {{else if isParty}}👥 {{/if}}{{actor.name}}</span>
      {{/if}}
    </div>

    <div class="header-controls-wrapper">
      {{#unless (or isParty isKingdom)}}
      <div class="header-target-group">
        <select name="target-select" class="touch-target header-select header-target-select m-compact m-truncate" data-change-action="selectTarget" aria-label="Select Target" title="{{#if hasMultipleTargets}}Targets ({{activeTargetCount}}): {{multiTargetNames}}{{else if activeTarget}}Target: {{activeTarget.displayName}}{{else}}Target Token{{/if}}">
          <option value="">🎯 No Target</option>
          <option value="__pick_multi__">🎯 Multi-Target Picker...</option>
          {{#if hasMultipleTargets}}
          <option value="__multi__" selected>🎯 {{activeTargetCount}} Targets ({{multiTargetNames}})</option>
          {{/if}}
          {{#each targets}}
          {{!-- Range first ("15ft Goblin"), so it stays visible when the select cuts off a long name --}}
          <option value="{{this.id}}" {{#if this.selectedInSingle}}selected{{/if}}>
            🎯 {{#if this.isSelf}}{{this.displayName}}{{else}}{{#if this.distanceLabel}}{{this.distanceLabel}}ft {{/if}}{{this.rawName}}{{/if}}
          </option>
          {{/each}}
        </select>
      </div>
      {{/unless}}

      <!-- Roll mode toggle: a die with a small coloured corner icon for who rolls it
           (blue chip = digital, yellow hand = your own dice). -->
      <button type="button" class="touch-target header-btn m-compact" data-action="toggleRollMode" title="{{#if isPhysicalRollMode}}Manual dice: you roll and enter the result (tap for digital){{else}}Digital dice (tap for manual){{/if}}" aria-label="Toggle Roll Mode">
        <i class="fas fa-dice"></i>
        <span class="header-btn-badge"><i class="fas {{#if isPhysicalRollMode}}fa-hand{{else}}fa-microchip{{/if}}"></i></span>
      </button>

      <!-- Settings menu: the cog shows the canvas and fullscreen controls in a small popover.
           Using either of them closes it again (closeHeaderMenu in header-handlers.js). -->
      <div class="header-menu">
        <button type="button" class="touch-target header-btn header-menu-toggle m-compact" data-action="toggleHeaderMenu" title="Settings" aria-label="Settings" aria-expanded="false">
          <i class="fas fa-cog"></i>
        </button>
        <div class="header-menu-panel m-gap-4">
          <button type="button" class="touch-target header-btn m-compact {{#unless canvasDisabled}}active{{/unless}}" data-action="toggleCanvasMode" title="{{#if canvasDisabled}}Canvas Disabled (Tap to Enable Canvas){{else}}Canvas Enabled (Tap to Disable Canvas){{/if}}" aria-label="Toggle Canvas">
            <i class="fas {{#if canvasDisabled}}fa-eye-slash{{else}}fa-map{{/if}}"></i>
          </button>

          <button type="button" class="touch-target header-btn btn-fullscreen m-compact" data-action="toggleFullscreen" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
            <i class="fas fa-expand"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  {{#if isKingdom}}
  <!-- Kingdom Overview Dashboard Strip -->
  <div class="kingdom-summary-strip">
    <div class="kingdom-header-badges">
      <span class="km-badge km-lvl"><i class="fa-solid fa-crown"></i> Lvl {{kingdomHeader.level}}</span>
      <span class="km-badge km-xp"><i class="fa-solid fa-star"></i> {{kingdomHeader.xp}} / {{kingdomHeader.xpMax}} XP</span>
      <span class="km-badge km-dc"><i class="fa-solid fa-shield-halved"></i> DC {{kingdomHeader.controlDc}}</span>
      <span class="km-badge km-fame"><i class="fa-solid fa-medal"></i> {{kingdomHeader.fameType}}: {{kingdomHeader.fameValue}}</span>
      <span class="km-badge km-unrest {{#if kingdomHeader.unrestPenalty}}has-penalty{{/if}}">
        <i class="fa-solid fa-fire-flame-curved"></i> Unrest {{kingdomHeader.unrest}} ({{kingdomHeader.unrestPenalty}})
      </span>
      {{#if kingdomHeader.atWar}}
      <span class="km-badge km-war"><i class="fa-solid fa-swords"></i> AT WAR</span>
      {{/if}}
    </div>
  </div>
  {{else if isParty}}
  <!-- Party Overview Dashboard Strip -->
  <div class="header-party-row">
    <div class="party-header-stat m-flex-row m-align-center m-gap-6">
      <i class="fas fa-users"></i> <span><strong>{{partyHeader.membersCount}}</strong> Members</span>
    </div>
    <div class="party-header-stat m-flex-row m-align-center m-gap-6">
      <i class="fas fa-coins"></i> <span><strong>{{partyHeader.totalWealth}}</strong></span>
    </div>
    <div class="party-header-stat m-flex-row m-align-center m-gap-6">
      <i class="fas fa-weight-hanging"></i> <span>Bulk: <strong>{{partyHeader.totalBulk}}</strong></span>
    </div>
  </div>
  {{else}}
  <!-- Row 2: Consolidated HP & Temp HP Streamlined Controls -->
  <div class="header-hp-row m-flex-row m-align-center m-justify-between m-gap-4">
    <!-- Quick Delta Box (+/-) on Left -->
    <div class="hp-delta-group m-flex-row m-align-center m-justify-center">
      <input type="text" class="hp-delta-input touch-target" data-change-action="applyDeltaHP" placeholder="±Amt" title="Enter heal amount or -damage (e.g. 5 to heal, -5 for damage)" aria-label="HP Delta" />
    </div>

    <!-- Current & Max HP with Direct Edit -->
    <div class="hp-direct-group hp- m-compact {{hp.state}} m-flex-row m-align-center m-justify-center m-gap-4 m-min-w-0">
      <span class="hp-label">HP</span>
      <div class="m-flex-row m-align-center m-gap-2">
        <input type="text" class="hp-current-input" data-change-action="setDirectHP" value="{{hp.value}}" title="Current HP (type number to set, or +/- to change)" aria-label="Current HP" />
        <span class="hp-slash">/</span>
        <span class="hp-max-value" title="Max HP">{{hp.max}}</span>
      </div>
    </div>

    <!-- Temp HP with Direct Edit -->
    <div class="temp-hp-direct-group m-compact m-flex-row m-align-center m-justify-center m-gap-4 m-min-w-0">
      <span class="temp-hp-label">TEMP</span>
      <div class="m-flex-row m-align-center">
        <input type="text" class="temp-hp-current-input" data-change-action="setDirectTempHP" value="{{hp.temp}}" title="Temp HP (type number to set, or +/- to change)" aria-label="Temporary HP" />
      </div>
    </div>

    {{#if shield.hp.max}}
    <div class="shield-badge-group m-flex-row m-align-center">
      <span class="defense-item shield-badge m-compact" title="Shield HP: {{shield.hp.value}}/{{shield.hp.max}} (Hardness {{shield.hardness}})">
        <strong>🛡️</strong> {{shield.hp.value}}/{{shield.hp.max}}
      </span>
    </div>
    {{/if}}
  </div>

  <!-- Row 3: Defenses, Saves & Perception/Initiative Pill Strip -->
  <div class="header-defenses-saves-row m-flex-row m-align-center m-justify-between m-gap-4">
    <span class="defense-item ac-badge m-compact" title="Armor Class: {{defenses.ac.value}}">
      <strong>AC</strong> {{defenses.ac.value}}
    </span>

    <button type="button" class="save-item touch-target m-compact" data-action="rollSave" data-save="fortitude" title="Roll Fortitude Save (+{{defenses.fortitude.mod}})">
      <strong>Fort</strong> +{{defenses.fortitude.mod}}
    </button>
    <button type="button" class="save-item touch-target m-compact" data-action="rollSave" data-save="reflex" title="Roll Reflex Save (+{{defenses.reflex.mod}})">
      <strong>Ref</strong> +{{defenses.reflex.mod}}
    </button>
    <button type="button" class="save-item touch-target m-compact" data-action="rollSave" data-save="will" title="Roll Will Save (+{{defenses.will.mod}})">
      <strong>Will</strong> +{{defenses.will.mod}}
    </button>

    <div class="perc-init-dropdown-wrapper m-flex-row m-min-w-0">
      <select class="touch-target perception-init-select m-compact m-truncate {{#if combat.active}}{{#if combat.hasRolled}}combat-rolled{{else}}combat-active{{/if}}{{/if}}" data-change-action="rollPerceptionOrInitiative" title="Roll Perception Check or Initiative" aria-label="Roll Perception or Initiative">
        <option value="" selected disabled>
          {{#if combat.active}}
            {{#if combat.hasRolled}}⚔️ {{combat.initiative}}{{else}}⚔️ Init{{/if}}
          {{else}}
            👁️ +{{defenses.perception.mod}}
          {{/if}}
        </option>
        <option value="perception">👁️ Perception (+{{defenses.perception.mod}})</option>
        <option value="initiative">⚔️ Initiative ({{#if combat.hasRolled}}{{combat.initiative}}{{else}}+{{initiative.mod}}{{/if}})</option>
      </select>
    </div>
  </div>
  {{/if}}
</header>
