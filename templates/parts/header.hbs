<header class="mobile-header-dashboard {{#if isParty}}party-header{{/if}} {{#if isKingdom}}kingdom-header{{/if}}">
  <!-- Row 1: Identity & Controls Toolbar -->
  <div class="header-top-row">
    <div class="actor-identity-wrapper">
      {{#if hasMultipleCharacters}}
      <select class="touch-target header-select actor-switcher" data-change-action="switchActor" title="Switch Character / Party / Kingdom" aria-label="Switch Character">
        {{#each ownedCharacters as |char|}}
        <option value="{{char.id}}" {{#if char.selected}}selected{{/if}}>
          {{char.name}}
        </option>
        {{/each}}
      </select>
      {{else}}
      <span class="actor-name" title="{{actor.name}}">{{#if isKingdom}}👑{{else if isParty}}👥{{else}}👤{{/if}} {{actor.name}}</span>
      {{/if}}
    </div>

    <div class="header-controls-wrapper">
      {{#unless (or isParty isKingdom)}}
      <div class="header-target-group">
        <select name="target-select" class="touch-target header-select header-target-select" data-change-action="selectTarget" aria-label="Select Target" title="{{#if hasMultipleTargets}}Targets ({{activeTargetCount}}): {{multiTargetNames}}{{else if activeTarget}}Target: {{activeTarget.displayName}}{{else}}Target Token{{/if}}">
          <option value="">🎯 No Target</option>
          <option value="__pick_multi__">🎯 Multi-Target Picker...</option>
          {{#if hasMultipleTargets}}
          <option value="__multi__" selected>🎯 {{activeTargetCount}} Targets ({{multiTargetNames}})</option>
          {{/if}}
          {{#each targets}}
          <option value="{{this.id}}" {{#if this.selectedInSingle}}selected{{/if}}>
            🎯 {{this.displayName}}
          </option>
          {{/each}}
        </select>
        {{#if hasMultipleTargets}}
        <span class="header-target-distance-pill" title="Targets: {{multiTargetNames}}">({{activeTargetCount}})</span>
        {{else if activeTarget.distanceLabel}}
        <span class="header-target-distance-pill" title="Distance to {{activeTarget.rawName}}">({{activeTarget.distanceLabel}})</span>
        {{/if}}
      </div>
      {{/unless}}

      <!-- Settings menu: the cog shows the roll mode, canvas and fullscreen controls in a small
           popover. Using any of them closes it again (closeHeaderMenu in header-handlers.js). -->
      <div class="header-menu">
        <button type="button" class="touch-target header-btn header-menu-toggle" data-action="toggleHeaderMenu" title="Settings" aria-label="Settings" aria-expanded="false">
          <i class="fas fa-cog"></i>
        </button>
        <div class="header-menu-panel">
          <select name="roll-mode" class="touch-target header-select" data-change-action="toggleRollMode" aria-label="Roll Mode" title="Roll Mode">
            <option value="digital" {{#if (eq rollMode "digital")}}selected{{/if}}>🎲</option>
            <option value="physical" {{#if (eq rollMode "physical")}}selected{{/if}}>✋</option>
          </select>

          <button type="button" class="touch-target header-btn {{#unless canvasDisabled}}active{{/unless}}" data-action="toggleCanvasMode" title="{{#if canvasDisabled}}Canvas Disabled (Tap to Enable Canvas){{else}}Canvas Enabled (Tap to Disable Canvas){{/if}}" aria-label="Toggle Canvas">
            <i class="fas {{#if canvasDisabled}}fa-eye-slash{{else}}fa-map{{/if}}"></i>
          </button>

          <button type="button" class="touch-target header-btn btn-fullscreen" data-action="toggleFullscreen" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
            <i class="fas fa-expand"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  {{#if isKingdom}}
  <!-- Kingdom Overview Dashboard Strip -->
  <div class="kingdom-summary-strip">
    <div class="kingdom-header-badges">
      <span class="km-badge km-lvl"><i class="fa-solid fa-crown"></i> Lvl {{kingdomHeader.level}}</span>
      <span class="km-badge km-xp"><i class="fa-solid fa-star"></i> {{kingdomHeader.xp}} / {{kingdomHeader.xpMax}} XP</span>
      <span class="km-badge km-dc"><i class="fa-solid fa-shield-halved"></i> DC {{kingdomHeader.controlDc}}</span>
      <span class="km-badge km-fame"><i class="fa-solid fa-medal"></i> {{kingdomHeader.fameType}}: {{kingdomHeader.fameValue}}</span>
      <span class="km-badge km-unrest {{#if kingdomHeader.unrestPenalty}}has-penalty{{/if}}">
        <i class="fa-solid fa-fire-flame-curved"></i> Unrest {{kingdomHeader.unrest}} ({{kingdomHeader.unrestPenalty}})
      </span>
      {{#if kingdomHeader.atWar}}
      <span class="km-badge km-war"><i class="fa-solid fa-swords"></i> AT WAR</span>
      {{/if}}
    </div>
  </div>
  {{else if isParty}}
  <!-- Party Overview Dashboard Strip -->
  <div class="header-party-row">
    <div class="party-header-stat">
      <i class="fas fa-users"></i> <span><strong>{{partyHeader.membersCount}}</strong> Members</span>
    </div>
    <div class="party-header-stat">
      <i class="fas fa-coins"></i> <span><strong>{{partyHeader.totalWealth}}</strong></span>
    </div>
    <div class="party-header-stat">
      <i class="fas fa-weight-hanging"></i> <span>Bulk: <strong>{{partyHeader.totalBulk}}</strong></span>
    </div>
  </div>
  {{else}}
  <!-- Row 2: Consolidated HP & Temp HP Streamlined Controls -->
  <div class="header-hp-row">
    <!-- Quick Delta Box (+/-) on Left -->
    <div class="hp-delta-group">
      <input type="text" class="hp-delta-input touch-target" data-change-action="applyDeltaHP" placeholder="±Amt" title="Enter heal amount or -damage (e.g. 5 to heal, -5 for damage)" aria-label="HP Delta" />
    </div>

    <!-- Current & Max HP with Direct Edit -->
    <div class="hp-direct-group">
      <span class="hp-label">HP</span>
      <div class="hp-input-container">
        <input type="text" class="hp-current-input" data-change-action="setDirectHP" value="{{hp.value}}" title="Current HP (type number to set, or +/- to change)" aria-label="Current HP" />
        <span class="hp-slash">/</span>
        <span class="hp-max-value" title="Max HP">{{hp.max}}</span>
      </div>
    </div>

    <!-- Temp HP with Direct Edit -->
    <div class="temp-hp-direct-group">
      <span class="temp-hp-label">TEMP</span>
      <div class="temp-hp-input-container">
        <input type="text" class="temp-hp-current-input" data-change-action="setDirectTempHP" value="{{hp.temp}}" title="Temp HP (type number to set, or +/- to change)" aria-label="Temporary HP" />
      </div>
    </div>

    {{#if shield.hp.max}}
    <div class="shield-badge-group">
      <span class="defense-item shield-badge" title="Shield HP: {{shield.hp.value}}/{{shield.hp.max}} (Hardness {{shield.hardness}})">
        <strong>🛡️</strong> {{shield.hp.value}}/{{shield.hp.max}}
      </span>
    </div>
    {{/if}}
  </div>

  <!-- Row 3: Defenses, Saves & Perception/Initiative Pill Strip -->
  <div class="header-defenses-saves-row">
    <span class="defense-item ac-badge" title="Armor Class: {{defenses.ac.value}}">
      <strong>AC</strong> {{defenses.ac.value}}
    </span>

    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="fortitude" title="Roll Fortitude Save (+{{defenses.fortitude.mod}})">
      <strong>Fort</strong> +{{defenses.fortitude.mod}}
    </button>
    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="reflex" title="Roll Reflex Save (+{{defenses.reflex.mod}})">
      <strong>Ref</strong> +{{defenses.reflex.mod}}
    </button>
    <button type="button" class="save-item touch-target" data-action="rollSave" data-save="will" title="Roll Will Save (+{{defenses.will.mod}})">
      <strong>Will</strong> +{{defenses.will.mod}}
    </button>

    <div class="perc-init-dropdown-wrapper">
      <select class="touch-target perception-init-select {{#if combat.active}}{{#if combat.hasRolled}}combat-rolled{{else}}combat-active{{/if}}{{/if}}" data-change-action="rollPerceptionOrInitiative" title="Roll Perception Check or Initiative" aria-label="Roll Perception or Initiative">
        <option value="" selected disabled>
          {{#if combat.active}}
            {{#if combat.hasRolled}}⚔️ {{combat.initiative}}{{else}}⚔️ Init{{/if}}
          {{else}}
            👁️ +{{defenses.perception.mod}}
          {{/if}}
        </option>
        <option value="perception">👁️ Perception (+{{defenses.perception.mod}})</option>
        <option value="initiative">⚔️ Initiative ({{#if combat.hasRolled}}{{combat.initiative}}{{else}}+{{initiative.mod}}{{/if}})</option>
      </select>
    </div>
  </div>
  {{/if}}
</header>
